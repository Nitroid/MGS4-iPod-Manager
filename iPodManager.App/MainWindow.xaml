                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="{StaticResource CenterHeaderTextColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Ideal"
                                               TextOptions.TextRenderingMode="Grayscale"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Width="24"
                            Height="24"
                            Margin="0,2,0,0"
                            Tag="close"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            MouseEnter="TooltipTarget_MouseEnter"
                            MouseLeave="TooltipTarget_MouseLeave"
                            Click="CloseWindow_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid Background="Transparent"
                                      UseLayoutRounding="False"
                                      SnapsToDevicePixels="False"
                                      TextOptions.TextHintingMode="Animated">
                                    <TextBlock Text="X"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="{StaticResource CenterHeaderShadowColor}"
                                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Ideal"
                                               TextOptions.TextRenderingMode="Grayscale">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                Y="{StaticResource CenterHeaderShadowOffset}"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock Text="X"
                                               Style="{StaticResource WindowControlGlyphPulseStyle}"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="{StaticResource CenterHeaderTextColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Ideal"
                                               TextOptions.TextRenderingMode="Grayscale"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>

                <!-- Main content area -->
                <Grid Grid.Row="1"
                      Margin="6,0,6,35">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Soft black border underlay -->
                    <Border Grid.Column="0"
                            Background="Transparent"
                            BorderBrush="{StaticResource CenterContentBorderColor}"
                            BorderThickness="{StaticResource CenterContentBorderThickness}"
                            CornerRadius="2"
                            Opacity="{StaticResource CenterContentBorderSoftOpacity}"
                            IsHitTestVisible="False">

                        <Border.Effect>
                            <BlurEffect Radius="{StaticResource CenterContentBorderBlurRadius}"/>
                        </Border.Effect>

                    </Border>

                    <!-- Crisp core keeps the softened edge visually defined -->
                    <Border Grid.Column="0"
                            Background="Transparent"
                            BorderBrush="{StaticResource CenterContentBorderColor}"
                            BorderThickness="{StaticResource CenterContentBorderThickness}"
                            CornerRadius="2"
                            IsHitTestVisible="False"/>

                    <!-- Nested left-side content area: 28.5% width, 4px inset -->
                    <Grid x:Name="LibraryListsArea"
                          Grid.Column="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.85*"/>
                            <ColumnDefinition Width="7.15*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Soft black border underlay -->
                        <Border x:Name="CategoryPanelSoftBorder"
                                Grid.Column="0"
                                Margin="4,4,2,53"
                                Background="Transparent"
                                BorderBrush="{StaticResource CenterContentBorderColor}"
                                BorderThickness="{StaticResource CenterContentBorderThickness}"
                                CornerRadius="2"
                                Opacity="{StaticResource CenterContentBorderSoftOpacity}"
                                IsHitTestVisible="False">

                            <Border.Effect>
                                <BlurEffect Radius="{StaticResource CenterContentBorderBlurRadius}"/>
                            </Border.Effect>

                        </Border>

                        <!-- Crisp core -->
                        <Border x:Name="CategoryPanelCrispBorder"
                                Grid.Column="0"
                                Margin="4,4,2,53"
                                Background="Transparent"
                                BorderBrush="{StaticResource CenterContentBorderColor}"
                                BorderThickness="{StaticResource CenterContentBorderThickness}"
                                CornerRadius="2"
                                IsHitTestVisible="False"/>

                        <!-- Nested panel content -->
                        <Grid x:Name="CategoryPanelContent"
                              Grid.Column="0"
                              VerticalAlignment="Top">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>

                            <!-- Top labels -->
                            <Grid Grid.Row="0"
                                  Margin="8,8,8,0">

                                <!-- Left label -->
                                <Grid HorizontalAlignment="Left"
                                      VerticalAlignment="Top">

                                    <!-- Shadow: matches Information -->
                                    <TextBlock Text="CATEGORIES"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CenterHeaderShadowColor}"
                                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                               TextOptions.TextFormattingMode="Display">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                Y="{StaticResource CenterHeaderShadowOffset}"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>

                                    <!-- Foreground: same softness as iPod / Information -->
                                    <TextBlock Text="CATEGORIES"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CenterHeaderTextColor}"
                                               TextOptions.TextFormattingMode="Display">
                                        <TextBlock.Effect>
                                            <BlurEffect Radius="{StaticResource CenterHeaderBlurRadius}"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                </Grid>

                                <!-- Right label -->
                                <Grid HorizontalAlignment="Right"
                                      VerticalAlignment="Top">

                                    <!-- Shadow: matches Information -->
                                    <TextBlock Text="{Binding CategoriesTotalSizeText, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CenterHeaderShadowColor}"
                                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                               TextOptions.TextFormattingMode="Display">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                Y="{StaticResource CenterHeaderShadowOffset}"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>

                                    <!-- Foreground: same softness as iPod / Information -->
                                    <TextBlock Text="{Binding CategoriesTotalSizeText, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CenterHeaderTextColor}"
                                               TextOptions.TextFormattingMode="Display">
                                        <TextBlock.Effect>
                                            <BlurEffect Radius="{StaticResource CenterHeaderBlurRadius}"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                </Grid>

                            </Grid>

                            <!-- Category count bar -->
                            <Grid Grid.Row="1"
                                  Height="13"
                                  Margin="7,5,7,0">

