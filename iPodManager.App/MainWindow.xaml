<Window x:Class="iPodManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:iPodManager"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:DesignHeight="450"
        d:DesignWidth="800"
        Title="iPod Manager"
        Icon="Assets/AppIcon.ico"
        Width="1280"
        Height="720"
        MinWidth="800"
        MinHeight="450"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <local:AddDoubleConverter x:Key="AddDoubleConverter"/>

        <!-- ========================================================= -->
        <!-- DESIGN VALUES                                             -->
        <!-- ========================================================= -->

        <!-- Side text -->
        <sys:String x:Key="LeftSideLabel"
                    xml:space="preserve">METAL   GEAR   SOLID   4   iPOD   MANAGER</sys:String>
        <sys:String x:Key="RightSideLabel"
                    xml:space="preserve">MANUFACTURED   BY   NITROID</sys:String>

        <!-- Side text font -->
        <FontFamily x:Key="MGS4PrimaryFont">
            ./Assets/Fonts/#Font of the Patriots
        </FontFamily>

        <!-- Side text size -->
        <sys:Double x:Key="SideLabelFontSize">9</sys:Double>

        <!-- Center header text -->
        <sys:String x:Key="CenterHeaderLabel">iPod</sys:String>
        <sys:String x:Key="SettingsHeaderLabel" xml:space="preserve">iPod    Manager</sys:String>

        <!-- Information header text -->
        <sys:String x:Key="InformationHeaderLabel">Information</sys:String>

        <!-- Center header text size -->
        <sys:Double x:Key="CenterHeaderFontSize">24</sys:Double>

        <!-- Center header character spacing -->
        <!-- More negative = tighter; positive = wider -->
        <Thickness x:Key="CenterHeaderCharacterSpacing">0,0,-3,0</Thickness>

        <!-- Side-label text softening -->
        <sys:Double x:Key="SideLabelBlurRadius">2</sys:Double>

        <!-- Center-header text softening -->
        <sys:Double x:Key="CenterHeaderBlurRadius">2</sys:Double>

        <!-- Center header shadow -->
        <SolidColorBrush x:Key="CenterHeaderShadowColor"
                         Color="Black"/>
        <sys:Double x:Key="CenterHeaderShadowOpacity">0.5</sys:Double>
        <sys:Double x:Key="InformationHeaderShadowOpacity">0.25</sys:Double>
        <sys:Double x:Key="CenterHeaderShadowOffset">3</sys:Double>

        <!-- Center content area -->
        <SolidColorBrush x:Key="CenterContentBorderColor"
                         Color="#CC000000"/>
        <Thickness x:Key="CenterContentBorderThickness">1</Thickness>
        <sys:Double x:Key="CenterContentBorderBlurRadius">4</sys:Double>
        <sys:Double x:Key="CenterContentBorderSoftOpacity">0.55</sys:Double>

        <!-- Tooltip text -->
        <FontFamily x:Key="MGS4SecondaryFont">
            ./Assets/Fonts/#SCE-PS3 Rodin LATIN
        </FontFamily>

        <!-- Categories text font -->
        <FontFamily x:Key="MGS4TertiaryFont">
            ./Assets/Fonts/#SCE-PS3 NewRodin JPN Regular
        </FontFamily>

        <sys:Double x:Key="TooltipFontSize">20</sys:Double>
        <SolidColorBrush x:Key="TooltipTextColor"
                         Color="#CCF3F3CF"/>

        <!-- Hole border thickness -->
        <sys:Double x:Key="HoleBorderThickness">1</sys:Double>

        <!-- Side text color -->
        <SolidColorBrush x:Key="SideLabelColor"
                         Color="#667661"/>

        <!-- Center header text color -->
        <SolidColorBrush x:Key="CenterHeaderTextColor"
                         Color="#CCF3F3CF"/>

        <!-- Side panel background -->
        <SolidColorBrush x:Key="SideBackground"
                         Color="#383F36"/>

        <!-- Center panel background -->
        <SolidColorBrush x:Key="CenterBackground"
                         Color="#383F36"/>

        <!-- Panel border -->
        <SolidColorBrush x:Key="PanelBorderColor"
                         Color="#94A48A"/>

        <!-- Shared pulsing mouseover treatment for the window-control glyphs themselves. -->
        <Style x:Key="WindowControlGlyphPulseStyle"
               TargetType="TextBlock">
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                             Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                                               RepeatBehavior="Forever">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.9"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.5">
                                        <EasingDoubleKeyFrame.EasingFunction>
                                            <QuadraticEase EasingMode="EaseIn"/>
                                        </EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.9"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Hole border -->
        <SolidColorBrush x:Key="HoleBorderColor"
                         Color="#94A48A"/>
        <sys:Double x:Key="HoleBorderSoftThickness">2</sys:Double>
        <sys:Double x:Key="HoleBorderSoftOpacity">0.35</sys:Double>
        <sys:Double x:Key="HoleBorderSoftBlurRadius">1.5</sys:Double>

        <!-- Grid lines -->
        <SolidColorBrush x:Key="GridColor"
                         Color="#17000000"/>

        <!-- Column darkness overlay -->
        <!--
            Vertical shading only; does not alter the actual panel background colors.
            Tuning:
              - Move the outer low-opacity stops to control how far the soft fade extends into the bright areas.
              - Move the two #CC020705 stops to change the size of the darkest central area.
              - Change the alpha in #CC020705 to adjust maximum darkness.
        -->
        <LinearGradientBrush x:Key="ColumnDarknessOverlay"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#00020705" Offset="0.00"/>
            <GradientStop Color="#17020705" Offset="0.04"/>
            <GradientStop Color="#33020705" Offset="0.08"/>
            <GradientStop Color="#55020705" Offset="0.12"/>
            <GradientStop Color="#7D020705" Offset="0.16"/>
            <GradientStop Color="#A4020705" Offset="0.20"/>
            <GradientStop Color="#BB020705" Offset="0.22"/>
            <GradientStop Color="#CC020705" Offset="0.24"/>

            <GradientStop Color="#CC020705" Offset="0.76"/>

            <GradientStop Color="#BB020705" Offset="0.78"/>
            <GradientStop Color="#A4020705" Offset="0.80"/>
            <GradientStop Color="#7D020705" Offset="0.84"/>
            <GradientStop Color="#55020705" Offset="0.88"/>
            <GradientStop Color="#33020705" Offset="0.92"/>
            <GradientStop Color="#17020705" Offset="0.96"/>
            <GradientStop Color="#00020705" Offset="1.00"/>
        </LinearGradientBrush>

        <!-- Inner glow -->
        <SolidColorBrush x:Key="GlowColor"
                         Color="#20FFFFFF"/>



        <!-- ========================================================= -->
        <!-- SIDE PANEL SHAPES                                         -->
        <!-- 100 x 100 design space                                    -->
        <!-- ========================================================= -->

        <!-- Left panel with actual transparent holes -->
        <GeometryGroup x:Key="LeftPanelGeometry"
                       FillRule="EvenOdd">

            <RectangleGeometry Rect="0,0,100,100"/>

            <!-- Top hole -->
            <RectangleGeometry Rect="81.5,5.4,7.0,1.2"/>

            <!-- Bottom hole -->
            <RectangleGeometry Rect="81.5,93.4,7.0,1.2"/>

        </GeometryGroup>


        <!-- Right panel with actual transparent holes -->
        <GeometryGroup x:Key="RightPanelGeometry"
                       FillRule="EvenOdd">

            <RectangleGeometry Rect="0,0,100,100"/>

            <!-- Top hole -->
            <RectangleGeometry Rect="11.5,5.4,7.0,1.2"/>

            <!-- Bottom hole -->
            <RectangleGeometry Rect="11.5,93.4,7.0,1.2"/>

        </GeometryGroup>


        <!-- ========================================================= -->
        <!-- SIDE PANEL BACKGROUND + GRID                              -->
        <!-- ========================================================= -->



        <!-- ========================================================= -->
        <!-- CENTER GRID                                               -->
        <!-- ========================================================= -->

        <DrawingBrush x:Key="CenterGridPattern"
                      TileMode="Tile"
                      Viewport="0,0,4,4"
                      ViewportUnits="Absolute">

            <DrawingBrush.Drawing>

                <GeometryDrawing>

                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource GridColor}"
                             Thickness="1"/>
                    </GeometryDrawing.Pen>

                    <GeometryDrawing.Geometry>
                        <GeometryGroup>

                            <LineGeometry StartPoint="0.5,0"
                                          EndPoint="0.5,4"/>

                            <LineGeometry StartPoint="0,0.5"
                                          EndPoint="4,0.5"/>

                        </GeometryGroup>
                    </GeometryDrawing.Geometry>

                </GeometryDrawing>

            </DrawingBrush.Drawing>

        </DrawingBrush>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- MAIN LAYOUT                                                   -->
    <!-- ============================================================= -->

    <Grid x:Name="MainLayoutRoot"
          Margin="0,20,0,20"
          Background="Transparent"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True"
          RenderOptions.EdgeMode="Aliased">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="8.5*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>


        <!-- ========================================================= -->
        <!-- LEFT COLUMN                                               -->
        <!-- ========================================================= -->

        <Grid Grid.Column="0"
              ClipToBounds="True">

            <!-- Fade toward left -->
            <Grid.OpacityMask>

                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">

                    <GradientStop Color="#00FFFFFF"
                                  Offset="0"/>

                    <GradientStop Color="#FFFFFFFF"
                                  Offset="0.25"/>

                    <GradientStop Color="#FFFFFFFF"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Grid.OpacityMask>


            <!-- Panel background + transparent holes -->
            <Path Data="{StaticResource LeftPanelGeometry}"
                  Stretch="Fill"
                  Fill="{StaticResource SideBackground}"
                  IsHitTestVisible="False"/>

            <!-- Vertical darkness overlay -->
            <Path Data="{StaticResource LeftPanelGeometry}"
                  Stretch="Fill"
                  Fill="{StaticResource ColumnDarknessOverlay}"
                  IsHitTestVisible="False"/>

            <!-- Grid above the darkness overlay -->
            <Path Data="{StaticResource LeftPanelGeometry}"
                  Stretch="Fill"
                  Fill="{StaticResource CenterGridPattern}"
                  IsHitTestVisible="False"/>


            <!-- Outer border: top, right, bottom only -->
            <Border BorderBrush="{StaticResource PanelBorderColor}"
                    BorderThickness="0,2,2,2"
                    CornerRadius="2"
                    IsHitTestVisible="False"/>


            <!-- Outer inner glow -->
            <Border BorderBrush="{StaticResource GlowColor}"
                    BorderThickness="0,2,2,2"
                    CornerRadius="2"
                    Margin="0,1,1,1"
                    IsHitTestVisible="False">

                <Border.Effect>
                    <DropShadowEffect Color="White"
                                      ShadowDepth="0"
                                      BlurRadius="5"
                                      Opacity="0.10"/>
                </Border.Effect>

            </Border>


            <!-- ===================================================== -->
            <!-- LEFT HOLE BORDERS                                     -->
            <!-- Same percentages as the actual cutout geometry        -->
            <!-- No Viewbox = uniform stroke thickness                 -->
            <!-- ===================================================== -->

            <!-- Soft same-color underlay -->
            <Grid IsHitTestVisible="False"
                  UseLayoutRounding="False"
                  SnapsToDevicePixels="False">

                <Grid.RowDefinitions>

                    <!-- 5.4% -->
                    <RowDefinition Height="5.4*"/>

                    <!-- Top hole: 1.2% -->
                    <RowDefinition Height="1.2*"/>

                    <!-- 86.8% -->
                    <RowDefinition Height="86.8*"/>

                    <!-- Bottom hole: 1.2% -->
                    <RowDefinition Height="1.2*"/>

                    <!-- 5.4% -->
                    <RowDefinition Height="5.4*"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>

                    <!-- 81.5% -->
                    <ColumnDefinition Width="81.5*"/>

                    <!-- Hole: 7.0% -->
                    <ColumnDefinition Width="7.0*"/>

                    <!-- Inner-edge gap: 11.5% -->
                    <ColumnDefinition Width="11.5*"/>

                </Grid.ColumnDefinitions>


                <!-- Top hole -->
                <Rectangle Grid.Row="1"
                           Grid.Column="1"
                           Fill="Transparent"
                           Stroke="{StaticResource HoleBorderColor}"
                           StrokeThickness="{StaticResource HoleBorderSoftThickness}"
                           Opacity="{StaticResource HoleBorderSoftOpacity}">

                    <Rectangle.Effect>
                        <BlurEffect Radius="{StaticResource HoleBorderSoftBlurRadius}"/>
                    </Rectangle.Effect>

                </Rectangle>


                <!-- Bottom hole -->
                <Rectangle Grid.Row="3"
                           Grid.Column="1"
                           Fill="Transparent"
                           Stroke="{StaticResource HoleBorderColor}"
                           StrokeThickness="{StaticResource HoleBorderSoftThickness}"
                           Opacity="{StaticResource HoleBorderSoftOpacity}">

                    <Rectangle.Effect>
                        <BlurEffect Radius="{StaticResource HoleBorderSoftBlurRadius}"/>
                    </Rectangle.Effect>

                </Rectangle>

            </Grid>


            <!-- Crisp hole edge -->
            <Grid IsHitTestVisible="False"
                  UseLayoutRounding="False"
                  SnapsToDevicePixels="False">

                <Grid.RowDefinitions>
                    <RowDefinition Height="5.4*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="86.8*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="5.4*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="81.5*"/>
                    <ColumnDefinition Width="7.0*"/>
                    <ColumnDefinition Width="11.5*"/>
                </Grid.ColumnDefinitions>


                <Rectangle Grid.Row="1"
                           Grid.Column="1"
                           Fill="Transparent"
                           Stroke="{StaticResource HoleBorderColor}"
                           StrokeThickness="{StaticResource HoleBorderThickness}"/>


                <Rectangle Grid.Row="3"
                           Grid.Column="1"
                           Fill="Transparent"
                           Stroke="{StaticResource HoleBorderColor}"
                           StrokeThickness="{StaticResource HoleBorderThickness}"/>

            </Grid>


            <!-- Side label -->
            <Grid IsHitTestVisible="False">

                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="1.4*"/>
                    <RowDefinition Height="87.2*"/>
                    <RowDefinition Height="1.4*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70*"/>
                    <ColumnDefinition Width="30*"/>
                </Grid.ColumnDefinitions>


                <!-- Clockwise -->
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{StaticResource LeftSideLabel}"
                           FontFamily="{StaticResource MGS4PrimaryFont}"
                           FontSize="{StaticResource SideLabelFontSize}"
                           Foreground="{StaticResource SideLabelColor}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"
                           Margin="0,0,4,0"
                           Padding="0"
                           TextOptions.TextFormattingMode="Display">

                    <TextBlock.Effect>
                        <BlurEffect Radius="{StaticResource SideLabelBlurRadius}"/>
                    </TextBlock.Effect>

                    <TextBlock.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.05" ScaleY="1"/>
                            <RotateTransform Angle="90"/>
                        </TransformGroup>
                    </TextBlock.LayoutTransform>

                </TextBlock>

            </Grid>

        </Grid>


        <!-- ========================================================= -->
        <!-- CENTER COLUMN                                             -->
        <!-- ========================================================= -->

        <Grid Grid.Column="2"
              ClipToBounds="True">

            <!-- Background -->
            <Border Background="{StaticResource CenterBackground}"/>

            <!-- Vertical darkness overlay -->
            <Rectangle Fill="{StaticResource ColumnDarknessOverlay}"
                       IsHitTestVisible="False"/>

            <!-- Tooltip area shadow -->
            <Border Height="26"
                    Margin="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource CenterHeaderShadowColor}"
                    Opacity="{StaticResource CenterHeaderShadowOpacity}"
                    IsHitTestVisible="False">

                <Border.RenderTransform>
                    <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                        Y="{StaticResource CenterHeaderShadowOffset}"/>
                </Border.RenderTransform>

            </Border>

            <!-- Tooltip area -->
            <Border Height="26"
                    Margin="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="#141F14"/>

            <!-- Grid -->
            <Rectangle Fill="{StaticResource CenterGridPattern}"
                       IsHitTestVisible="False"/>

            <!-- Tooltip text viewport -->
            <!-- Clipped + translated so it can later be scrolled horizontally from C#. -->
            <Grid x:Name="TooltipTextViewport"
                  Height="26"
                  Margin="6"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Bottom"
                  ClipToBounds="True"
                  IsHitTestVisible="False"
                  UseLayoutRounding="False"
                  SnapsToDevicePixels="False"
                  TextOptions.TextHintingMode="Animated"
                  Loaded="TrackTitleViewport_Loaded"
                  SizeChanged="TrackTitleViewport_SizeChanged"
                  Unloaded="TrackTitleViewport_Unloaded">

                <Canvas ClipToBounds="True">
                    <Grid Height="{Binding ActualHeight, ElementName=TooltipTextViewport}"
                          Margin="8,0,8,0"
                          Canvas.Left="3"
                          Canvas.Top="0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text, ElementName=TooltipText}"
                                   FontFamily="{StaticResource MGS4SecondaryFont}"
                                   FontSize="{StaticResource TooltipFontSize}"
                                   Foreground="{StaticResource CenterHeaderShadowColor}"
                                   Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="None"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="Grayscale">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                    Y="{StaticResource CenterHeaderShadowOffset}"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock x:Name="TooltipText"
                                   Text=""
                                   FontFamily="{StaticResource MGS4SecondaryFont}"
                                   FontSize="{StaticResource TooltipFontSize}"
                                   Foreground="{StaticResource TooltipTextColor}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="None"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="Grayscale"/>
                    </Grid>
                </Canvas>

            </Grid>

            <!-- Border on all sides -->
            <Border BorderBrush="{StaticResource PanelBorderColor}"
                    BorderThickness="2"
                    CornerRadius="2"
                    IsHitTestVisible="False"/>

            <!-- Inner glow -->
            <Border BorderBrush="{StaticResource GlowColor}"
                    BorderThickness="2"
                    CornerRadius="2"
                    Margin="1"
                    IsHitTestVisible="False">

                <Border.Effect>
                    <DropShadowEffect Color="White"
                                      ShadowDepth="0"
                                      BlurRadius="5"
                                      Opacity="0.10"/>
                </Border.Effect>

            </Border>

            <!-- Functional UI -->
            <Grid>

                <!-- Header anchored directly to the top-left of the center panel. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: icon uses its natural aspect ratio; text receives the remaining width. -->
                <Grid Grid.Row="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Kiku icon shadow -->
                    <Rectangle Grid.Column="0"
                               Width="45"
                               Height="45"
                               Fill="{StaticResource CenterHeaderShadowColor}"
                               Opacity="{StaticResource CenterHeaderShadowOpacity}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="0,0,10,0"
                               IsHitTestVisible="False">

                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/Images/icon_kiku.png"
                                        Stretch="Uniform"/>
                        </Rectangle.OpacityMask>

                        <Rectangle.RenderTransform>
                            <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                Y="{StaticResource CenterHeaderShadowOffset}"/>
                        </Rectangle.RenderTransform>

                    </Rectangle>

                    <!-- Kiku icon -->
                    <Rectangle Grid.Column="0"
                               Width="45"
                               Height="45"
                               Fill="{StaticResource CenterHeaderTextColor}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="0,0,10,0"
                               IsHitTestVisible="False">

                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/Images/icon_kiku.png"
                                        Stretch="Uniform"/>
                        </Rectangle.OpacityMask>

                    </Rectangle>

                    <!-- iPod label: tracked text -->
                    <Grid Grid.Column="1"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">

                        <!-- Shadow -->
                        <ItemsControl ItemsSource="{StaticResource CenterHeaderLabel}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Opacity="{StaticResource CenterHeaderShadowOpacity}"
                                      IsHitTestVisible="False">

                            <ItemsControl.RenderTransform>
                                <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                    Y="{StaticResource CenterHeaderShadowOffset}"/>
                            </ItemsControl.RenderTransform>

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{StaticResource MGS4PrimaryFont}"
                                               FontSize="{StaticResource CenterHeaderFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CenterHeaderShadowColor}"
                                               Margin="{StaticResource CenterHeaderCharacterSpacing}"
                                               TextOptions.TextFormattingMode="Display">


                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <!-- Foreground -->
                        <ItemsControl ItemsSource="{StaticResource CenterHeaderLabel}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">

                            <ItemsControl.Effect>
                                <BlurEffect Radius="{StaticResource CenterHeaderBlurRadius}"/>
                            </ItemsControl.Effect>

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{StaticResource MGS4PrimaryFont}"
                                               FontSize="{StaticResource CenterHeaderFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CenterHeaderTextColor}"
                                               Margin="{StaticResource CenterHeaderCharacterSpacing}"
                                               TextOptions.TextFormattingMode="Display"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </Grid>

                <!-- Information header aligned to the iPod header row -->
                <Grid Grid.Row="0"
                      Margin="6,0,6,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      IsHitTestVisible="False">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1"
                          Margin="8,0,8,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center">

                        <!-- Shadow -->
                        <ItemsControl ItemsSource="{StaticResource InformationHeaderLabel}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                      IsHitTestVisible="False">

                            <ItemsControl.RenderTransform>
                                <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                    Y="{StaticResource CenterHeaderShadowOffset}"/>
                            </ItemsControl.RenderTransform>

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{StaticResource MGS4PrimaryFont}"
                                               FontSize="{StaticResource CenterHeaderFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CenterHeaderShadowColor}"
                                               Margin="{StaticResource CenterHeaderCharacterSpacing}"
                                               TextOptions.TextFormattingMode="Display"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <!-- Foreground -->
                        <ItemsControl ItemsSource="{StaticResource InformationHeaderLabel}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False">

                            <ItemsControl.Effect>
                                <BlurEffect Radius="{StaticResource CenterHeaderBlurRadius}"/>
                            </ItemsControl.Effect>

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{StaticResource MGS4PrimaryFont}"
                                               FontSize="{StaticResource CenterHeaderFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CenterHeaderTextColor}"
                                               Margin="{StaticResource CenterHeaderCharacterSpacing}"
                                               TextOptions.TextFormattingMode="Display"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </Grid>

                <!-- Window controls in the center panel's top-right corner. -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,2,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">

                    <Button Width="24"
                            Height="24"
                            Margin="0"
                            Tag="minimize"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            MouseEnter="TooltipTarget_MouseEnter"
                            MouseLeave="TooltipTarget_MouseLeave"
                            Click="MinimizeWindow_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid Background="Transparent"
                                      UseLayoutRounding="False"
                                      SnapsToDevicePixels="False"
                                      TextOptions.TextHintingMode="Animated">
                                    <TextBlock Text="—"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="{StaticResource CenterHeaderShadowColor}"
                                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Ideal"
                                               TextOptions.TextRenderingMode="Grayscale">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                Y="{StaticResource CenterHeaderShadowOffset}"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock Text="—"
