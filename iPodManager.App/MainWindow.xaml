                                <!-- Centered count label -->
                                <Grid HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="-0.5"/>
                                    </Grid.RenderTransform>

                                    <!-- Shadow: matches Information -->
                                    <TextBlock Text="[ 3 / 3 ]"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="9"
                                               Foreground="{StaticResource CenterHeaderShadowColor}"
                                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                               TextOptions.TextFormattingMode="Display">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="0.5"
                                                                Y="0.5"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>

                                    <!-- Foreground: same softness as CATEGORIES -->
                                    <TextBlock Text="[ 3 / 3 ]"
                                               FontFamily="{StaticResource MGS4PrimaryFont}"
                                               FontSize="9"
                                               Foreground="{StaticResource CenterHeaderTextColor}"
                                               TextOptions.TextFormattingMode="Display">
                                        <TextBlock.Effect>
                                            <BlurEffect Radius="{StaticResource CenterHeaderBlurRadius}"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                </Grid>

                            </Grid>

                            <!-- Dynamic category list -->
                            <ListBox x:Name="CategoryList"
                                     Grid.Row="2"
                                     Tag="categories"
                                     ItemsSource="{Binding CategoryItems, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                     SelectedIndex="0"
                                     SelectionChanged="CategoryList_SelectionChanged"
                                     PreviewMouseLeftButtonDown="CategoryList_PreviewMouseLeftButtonDown"
                                     PreviewMouseLeftButtonUp="CategoryList_PreviewMouseLeftButtonUp"
                                     PreviewKeyDown="CategoryList_PreviewKeyDown"
                                     LostMouseCapture="CategoryList_LostMouseCapture"
                                     MouseEnter="TooltipTarget_MouseEnter"
                                     MouseLeave="TooltipTarget_MouseLeave"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AlternationCount="2147483647">

                                <!-- Preserve the custom MGS4 row appearance instead of WPF's default ListBox chrome. -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Grid Background="Transparent">

                                                        <!-- Persistent highlight for the active category. -->
                                                        <Border x:Name="SelectedHighlight"
                                                                Margin="5,0,5,1"
                                                                Opacity="0"
                                                                IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                     EndPoint="1,0">
                                                                    <GradientStop Color="#0094A48A" Offset="0"/>
                                                                    <GradientStop Color="#FF94A48A" Offset="0.015"/>
                                                                    <GradientStop Color="#FF94A48A" Offset="0.985"/>
                                                                    <GradientStop Color="#0094A48A" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- Full-row mouseover highlight for inactive categories. -->
                                                        <Border x:Name="HoverHighlight"
                                                                Margin="5,0,5,1"
                                                                Opacity="0"
                                                                IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                     EndPoint="1,0">
                                                                    <GradientStop Color="#0094A48A" Offset="0"/>
                                                                    <GradientStop Color="#FF94A48A" Offset="0.015"/>
                                                                    <GradientStop Color="#FF94A48A" Offset="0.985"/>
                                                                    <GradientStop Color="#0094A48A" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <ContentPresenter/>

                                                    </Grid>

                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected"
                                                                 Value="True">
                                                            <Setter TargetName="SelectedHighlight"
                                                                    Property="Opacity"
                                                                    Value="0.34"/>
                                                        </Trigger>

                                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                                            <BeginStoryboard Name="CategoryPressedHighlightSuppression">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="SelectedHighlight"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0"
                                                                                     Duration="0:0:0"/>
                                                                    <DoubleAnimation Storyboard.TargetName="HoverHighlight"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0"
                                                                                     Duration="0:0:0"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>

                                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                                            <RemoveStoryboard BeginStoryboardName="CategoryPressedHighlightSuppression"/>
                                                        </EventTrigger>

                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <RemoveStoryboard BeginStoryboardName="CategoryPressedHighlightSuppression"/>
                                                        </EventTrigger>

                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="IsSelected" Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <!-- The animated layer replaces the steady selected highlight while hovered. -->
                                                            <Setter TargetName="SelectedHighlight"
                                                                    Property="Opacity"
                                                                    Value="0"/>
                                                        </MultiTrigger>

                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                            </MultiTrigger.Conditions>

                                                            <!-- Linear 1-second pulse. It starts 80% through the rise,
                                                                 peaks, falls to half brightness, then returns seamlessly. -->
                                                            <MultiTrigger.EnterActions>
                                                                <BeginStoryboard Name="CategoryHoverPulse">
                                                                    <Storyboard>
                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverHighlight"
                                                                                                       Storyboard.TargetProperty="Opacity"
                                                                                                       RepeatBehavior="Forever">
                                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                                                                                    Value="0.306"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.1"
                                                                                                  Value="0.34"/>
                                                                            <EasingDoubleKeyFrame KeyTime="0:0:0.6"
                                                                                                  Value="0.17">
                                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseIn"/>
                                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                                            </EasingDoubleKeyFrame>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:1"
                                                                                                  Value="0.306"/>
                                                                        </DoubleAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiTrigger.EnterActions>

                                                            <!-- Mouse-out is intentionally instantaneous. -->
                                                            <MultiTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="CategoryHoverPulse"/>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="HoverHighlight"
                                                                                         Storyboard.TargetProperty="Opacity"
                                                                                         To="0"
                                                                                         Duration="0:0:0"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiTrigger.ExitActions>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <!-- Every object in CategoryItems is rendered with this template. -->
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="60"
                                              Margin="5,0,5,0"
                                              HorizontalAlignment="Stretch"
                                              Background="Transparent"
                                              MouseEnter="CategoryListItem_MouseEnter">

                                            <!-- Top separator: shown only above the first item. -->
                                            <Grid x:Name="FirstItemTopSeparator"
                                                  VerticalAlignment="Top"
                                                  Visibility="Collapsed"
                                                  IsHitTestVisible="False">

                                                <!-- Slightly stronger soft white glow below the separator. -->
                                                <Border Height="1"
                                                        Margin="5,0,5,0"
                                                        VerticalAlignment="Top"
                                                        Background="White"
                                                        Opacity="0.16">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform Y="1"/>
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <BlurEffect Radius="2"/>
                                                    </Border.Effect>
                                                </Border>

                                                <!-- Slightly stronger black separator line. -->
                                                <Border Height="1"
                                                        Margin="5,0,5,0"
                                                        VerticalAlignment="Top"
                                                        Background="Black"
                                                        Opacity="0.36"/>

                                            </Grid>

                                            <!-- Bottom separator: gives the between-item lines and closes the list below the final item. -->
                                            <Grid VerticalAlignment="Bottom"
                                                  IsHitTestVisible="False">

                                                <!-- Slightly stronger soft white glow below the separator. -->
                                                <Border Height="1"
                                                        Margin="5,0,5,0"
                                                        VerticalAlignment="Bottom"
                                                        Background="White"
                                                        Opacity="0.16">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform Y="1"/>
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <BlurEffect Radius="2"/>
                                                    </Border.Effect>
                                                </Border>

                                                <!-- Slightly stronger black separator line. -->
                                                <Border Height="1"
                                                        Margin="5,0,5,0"
                                                        VerticalAlignment="Bottom"
                                                        Background="Black"
                                                        Opacity="0.36"/>

                                            </Grid>

                                            <!-- Category icon centered behind the item label. -->
                                            <Rectangle Height="48"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Center"
                                                       Fill="#62CEE6"
                                                       UseLayoutRounding="False"
                                                       SnapsToDevicePixels="False"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       RenderOptions.EdgeMode="Unspecified"
                                                       IsHitTestVisible="False">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{Binding IconSource}"
                                                                Stretch="Uniform"
                                                                AlignmentX="Center"
                                                                AlignmentY="Center"/>
                                                </Rectangle.OpacityMask>
                                            </Rectangle>

                                            <!-- Centered item label: CATEGORIES style, slightly larger -->
                                            <Grid HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  UseLayoutRounding="False"
                                                  SnapsToDevicePixels="False"
                                                  TextOptions.TextHintingMode="Animated">

                                                <!-- Shadow: matches CATEGORIES -->
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                                           FontSize="12"
                                                           FontWeight="Normal"
                                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                                           Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                                           TextOptions.TextFormattingMode="Ideal"
                                                           TextOptions.TextRenderingMode="Grayscale">
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>

                                                <!-- Foreground: clean text avoids bitmap distortion from BlurEffect -->
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                                           FontSize="12"
                                                           FontWeight="Normal"
                                                           Foreground="{StaticResource CenterHeaderTextColor}"
                                                           TextOptions.TextFormattingMode="Ideal"
                                                           TextOptions.TextRenderingMode="Grayscale"/>

                                            </Grid>

                                            <!-- Top-right metadata: exact 0.00 MB text style -->
                                            <Grid HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  Margin="0,5,5,0">

                                                <!-- Shadow: matches 0.00 MB -->
                                                <TextBlock Text="{Binding SizeText}"
                                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                                           Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                                           TextOptions.TextFormattingMode="Display">
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>

                                                <!-- Foreground: same softness as 0.00 MB -->
                                                <TextBlock Text="{Binding SizeText}"
                                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource CenterHeaderTextColor}"
                                                           TextOptions.TextFormattingMode="Display">
                                                    <TextBlock.Effect>
                                                        <BlurEffect Radius="{StaticResource CenterHeaderBlurRadius}"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>

                                            </Grid>

                                        </Grid>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=(ItemsControl.AlternationIndex)}"
                                                         Value="0">
                                                <Setter TargetName="FirstItemTopSeparator"
                                                        Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                            <!-- Closing divider is outside the ListBox ScrollViewer so its glow is not clipped. -->
                            <Grid Grid.Row="3"
                                  Margin="10,0,10,0"
                                  VerticalAlignment="Top"
                                  IsHitTestVisible="False">
                                <Grid.RenderTransform>
                                    <TranslateTransform Y="-2"/>
                                </Grid.RenderTransform>
                                <Border Height="1"
                                        VerticalAlignment="Top"
                                        Background="White"
                                        Opacity="0.16">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="1"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <BlurEffect Radius="2"/>
                                    </Border.Effect>
                                </Border>
                                <Border Height="1"
                                        VerticalAlignment="Top"
                                        Background="Black"
                                        Opacity="0.36"/>
                            </Grid>

                        </Grid>

                        <!-- Settings button occupying the space below the shortened categories panel. -->
                        <Grid x:Name="SettingsButton"
                              Grid.Column="0"
                              Height="45"
                              Margin="4,4,2,4"
                              Tag="settings"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom"
                              Cursor="Hand"
                              MouseEnter="TooltipTarget_MouseEnter"
                              MouseLeave="TooltipTarget_MouseLeave"
                              PreviewMouseLeftButtonDown="SettingsButton_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="SettingsButton_Click">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="0,1">
                                    <GradientStop Color="#BF142014" Offset="0"/>
                                    <GradientStop Color="#604A5540" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>

                            <!-- Match the track-item hover treatment used by Transfer to iPod. -->
                            <Border x:Name="SettingsHoverHighlight"
                                    CornerRadius="2"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}"
                                                         Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                                                                           RepeatBehavior="Forever">
                                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.306"/>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0.34"/>
                                                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.17">
                                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                                </EasingDoubleKeyFrame>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.306"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="0"
                                                                             Duration="0:0:0"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0"
                                                         EndPoint="1,0">
                                        <GradientStop Color="#0094A48A" Offset="0"/>
                                        <GradientStop Color="#FF94A48A" Offset="0.0075"/>
                                        <GradientStop Color="#FF94A48A" Offset="0.9925"/>
                                        <GradientStop Color="#0094A48A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Background="Transparent"
                                    BorderBrush="{StaticResource CenterContentBorderColor}"
                                    BorderThickness="{StaticResource CenterContentBorderThickness}"
                                    CornerRadius="2"
                                    Opacity="{StaticResource CenterContentBorderSoftOpacity}"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <BlurEffect Radius="{StaticResource CenterContentBorderBlurRadius}"/>
                                </Border.Effect>
                            </Border>

                            <Border Background="Transparent"
                                    BorderBrush="{StaticResource CenterContentBorderColor}"
                                    BorderThickness="{StaticResource CenterContentBorderThickness}"
                                    CornerRadius="2"
                                    IsHitTestVisible="False"/>

                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Opacity="1"
                                  UseLayoutRounding="False"
                                  SnapsToDevicePixels="False"
                                  TextOptions.TextHintingMode="Animated">
                                <Grid.RenderTransform>
                                    <TranslateTransform Y="-1"/>
                                </Grid.RenderTransform>
                                <TextBlock Text="SETTINGS"
                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                           FontSize="13"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                           Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <TextBlock Text="SETTINGS"
                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                           FontSize="13"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderTextColor}"
                                           Opacity="1"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale"/>
                            </Grid>
                        </Grid>

                        <Border x:Name="KonamiVideoFrame"
                                Grid.Column="0"
                                Panel.ZIndex="10"
                                Height="100"
                                Margin="4,0,2,53"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Background="Black"
                                BorderBrush="Black"
                                BorderThickness="1"
                                CornerRadius="2"
                                ClipToBounds="True"
                                Visibility="Collapsed"
                                MouseEnter="TooltipTarget_MouseEnter"
                                MouseLeave="TooltipTarget_MouseLeave"
                                SizeChanged="KonamiVideoFrame_SizeChanged">
                            <MediaElement x:Name="KonamiVideo"
                                          Stretch="UniformToFill"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          MediaEnded="KonamiVideo_MediaEnded"
                                          MediaFailed="KonamiVideo_MediaFailed"/>
                        </Border>

                        <!-- Nested right-side content area: 3px center gutter, 4px outer inset -->
                        <!-- Soft black border underlay -->
                        <Border x:Name="TrackPanelSoftBorder"
                                Grid.Column="1"
                                Margin="1,4,4,4"
                                Background="Transparent"
                                BorderBrush="{StaticResource CenterContentBorderColor}"
                                BorderThickness="{StaticResource CenterContentBorderThickness}"
                                CornerRadius="2"
                                Opacity="{StaticResource CenterContentBorderSoftOpacity}"
                                IsHitTestVisible="False">

                            <Border.Effect>
                                <BlurEffect Radius="{StaticResource CenterContentBorderBlurRadius}"/>
                            </Border.Effect>

                        </Border>

                        <!-- Crisp core -->
                        <Border x:Name="TrackPanelCrispBorder"
                                Grid.Column="1"
                                Margin="1,4,4,4"
                                Background="Transparent"
                                BorderBrush="{StaticResource CenterContentBorderColor}"
                                BorderThickness="{StaticResource CenterContentBorderThickness}"
                                CornerRadius="2"
                                IsHitTestVisible="False"/>

                        <!-- Nested right panel content: constrained to the same visible bounds as the parent border. -->
                        <Grid x:Name="TrackListPanel"
                              Grid.Column="1"
                              Margin="1,4,4,4"
                              Tag="track_selection"
                              ClipToBounds="True"
                              Loaded="TrackListPanel_Loaded"
                              MouseEnter="TooltipTarget_MouseEnter"
                              MouseLeave="TooltipTarget_MouseLeave">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid.Resources>

                                <!-- Dynamic tab style: open-bottom album/podcast tabs. -->
                                <Style x:Key="TrackListTabStyle"
                                       TargetType="ListBoxItem">
                                    <Setter Property="MinWidth" Value="84"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid Background="Transparent">

                                                    <!-- Selected-tab glow: strongest at the top edge and fading downward. -->
                                                    <Border x:Name="ActiveTopGlow"
                                                            Height="24"
                                                            Margin="1,1,1,0"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Top"
                                                            Opacity="0"
                                                            IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0"
                                                                                 EndPoint="0,1">
                                                                <GradientStop Color="#B894A48A" Offset="0"/>
                                                                <GradientStop Color="#7094A48A" Offset="0.22"/>
                                                                <GradientStop Color="#2494A48A" Offset="0.58"/>
                                                                <GradientStop Color="#0094A48A" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <BlurEffect Radius="8"/>
                                                        </Border.Effect>
                                                    </Border>

                                                    <!-- Soft black border underlay; bottom edge intentionally open. -->
                                                    <Border Background="Transparent"
                                                            BorderBrush="{StaticResource CenterContentBorderColor}"
                                                            BorderThickness="1,1,1,0"
                                                            CornerRadius="2,2,0,0"
                                                            Opacity="{StaticResource CenterContentBorderSoftOpacity}"
                                                            IsHitTestVisible="False">
                                                        <Border.Effect>
                                                            <BlurEffect Radius="{StaticResource CenterContentBorderBlurRadius}"/>
                                                        </Border.Effect>
                                                    </Border>

                                                    <!-- Crisp core; bottom edge intentionally open. -->
                                                    <Border Background="Transparent"
                                                            BorderBrush="{StaticResource CenterContentBorderColor}"
                                                            BorderThickness="1,1,1,0"
                                                            CornerRadius="2,2,0,0"
                                                            IsHitTestVisible="False"/>

                                                    <!-- Label: matches the centered category list-item typography. -->
                                                    <Grid Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          UseLayoutRounding="False"
                                                          SnapsToDevicePixels="False"
                                                          TextOptions.TextHintingMode="Animated">

                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="{StaticResource MGS4TertiaryFont}"
                                                                   FontSize="12"
                                                                   FontWeight="Normal"
                                                                   Foreground="{StaticResource CenterHeaderShadowColor}"
                                                                   Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                                                   TextOptions.TextFormattingMode="Ideal"
                                                                   TextOptions.TextRenderingMode="Grayscale">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                                    Y="{StaticResource CenterHeaderShadowOffset}"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>

                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="{StaticResource MGS4TertiaryFont}"
                                                                   FontSize="12"
                                                                   FontWeight="Normal"
                                                                   Foreground="{StaticResource CenterHeaderTextColor}"
                                                                   TextOptions.TextFormattingMode="Ideal"
                                                                   TextOptions.TextRenderingMode="Grayscale"/>

                                                    </Grid>

                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ActiveTopGlow"
                                                                Property="Opacity"
                                                                Value="0.78"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <!-- Shared visual template for the sample track rows. -->
                                <DataTemplate x:Key="TrackListItemTemplate">
                                    <Grid Height="45"
                                          Margin="4,5,0,0"
                                          HorizontalAlignment="Stretch"
                                          Background="Transparent"
                                          MouseEnter="TrackListItem_MouseEnter">

                                        <!-- Same mouseover highlight used by the category list items.
                                             The animation lives in the Border's own style so WPF does not
                                             have to resolve a named child across a separate trigger namescope. -->
                                        <Border x:Name="TrackHoverHighlight"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}"
                                                                     Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                                                                                       RepeatBehavior="Forever">
                                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.306"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0.34"/>
                                                                            <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.17">
                                                                                <EasingDoubleKeyFrame.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseIn"/>
                                                                                </EasingDoubleKeyFrame.EasingFunction>
                                                                            </EasingDoubleKeyFrame>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.306"/>
                                                                        </DoubleAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="0"
                                                                                         Duration="0:0:0"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0"
                                                                     EndPoint="1,0">
                                                    <GradientStop Color="#0094A48A" Offset="0"/>
                                                    <GradientStop Color="#FF94A48A" Offset="0.0075"/>
                                                    <GradientStop Color="#FF94A48A" Offset="0.9925"/>
                                                    <GradientStop Color="#0094A48A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Soft black border underlay -->
                                        <Border Background="Transparent"
                                                BorderBrush="{StaticResource CenterContentBorderColor}"
                                                BorderThickness="{StaticResource CenterContentBorderThickness}"
                                                CornerRadius="2"
                                                Opacity="{StaticResource CenterContentBorderSoftOpacity}"
                                                IsHitTestVisible="False">
                                            <Border.Effect>
                                                <BlurEffect Radius="{StaticResource CenterContentBorderBlurRadius}"/>
                                            </Border.Effect>
                                        </Border>

                                        <!-- Crisp core -->
                                        <Border Background="Transparent"
                                                BorderBrush="{StaticResource CenterContentBorderColor}"
                                                BorderThickness="{StaticResource CenterContentBorderThickness}"
                                                CornerRadius="2"
                                                IsHitTestVisible="False"/>

                                        <!-- Track label panel begins 10px after the checkbox and uses 45% of the row height. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="45*"/>
                                                <RowDefinition Height="55*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Checkmark toggle at the far left of the track row. -->
                                            <ToggleButton Grid.RowSpan="2"
                                                          Grid.Column="0"
                                                          Width="21"
                                                          Height="21"
                                                          Margin="10,0,0,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                           Click="TrackCheckToggle_Click"
                                                           Focusable="False">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                        <Grid>
                                                            <Rectangle x:Name="CheckmarkIcon"
                                                                       Fill="#6B716B"
                                                                       Opacity="0.55"
                                                                       SnapsToDevicePixels="False"
                                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                                <Rectangle.OpacityMask>
                                                                    <ImageBrush ImageSource="Assets/Images/icon_checkmark.png"
                                                                                Stretch="Uniform"/>
                                                                </Rectangle.OpacityMask>
                                                            </Rectangle>

                                                            <Border Background="Transparent"
                                                                    BorderBrush="{StaticResource CenterContentBorderColor}"
                                                                    BorderThickness="{StaticResource CenterContentBorderThickness}"
                                                                    CornerRadius="2"
                                                                    Opacity="{StaticResource CenterContentBorderSoftOpacity}"
                                                                    IsHitTestVisible="False">
                                                                <Border.Effect>
                                                                    <BlurEffect Radius="{StaticResource CenterContentBorderBlurRadius}"/>
                                                                </Border.Effect>
                                                            </Border>

                                                            <Border Background="Transparent"
                                                                    BorderBrush="{StaticResource CenterContentBorderColor}"
                                                                    BorderThickness="{StaticResource CenterContentBorderThickness}"
                                                                    CornerRadius="2"
                                                                    IsHitTestVisible="False"/>
                                                        </Grid>

                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="CheckmarkIcon"
                                                                        Property="Fill"
                                                                        Value="#62CEE6"/>
                                                                <Setter TargetName="CheckmarkIcon"
                                                                        Property="Opacity"
                                                                        Value="0.8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <!-- Artist marquee ends 5px before the auto-sized filesize text. -->
                                            <Grid Grid.Row="1"
                                                  Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0"
                                                      Margin="2,0,0,0"
                                                      ClipToBounds="True"
                                                      UseLayoutRounding="False"
                                                      SnapsToDevicePixels="False"
                                                      TextOptions.TextHintingMode="Animated"
                                                      IsHitTestVisible="False"
                                                      Loaded="TrackTitleViewport_Loaded"
                                                      SizeChanged="TrackTitleViewport_SizeChanged"
                                                      Unloaded="TrackTitleViewport_Unloaded">
                                                    <Canvas ClipToBounds="True">
                                                        <Grid Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type Canvas}}}"
                                                              Canvas.Left="3"
                                                              Canvas.Top="0"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ArtistText}"
                                                                       FontFamily="{StaticResource MGS4TertiaryFont}"
                                                                       FontSize="11"
                                                                       FontWeight="Normal"
                                                                       Foreground="{StaticResource CenterHeaderShadowColor}"
                                                                       Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                                                       VerticalAlignment="Center"
                                                                       TextOptions.TextFormattingMode="Ideal"
                                                                       TextOptions.TextRenderingMode="Grayscale">
                                                                <TextBlock.RenderTransform>
                                                                    <TranslateTransform X="2" Y="2"/>
                                                                </TextBlock.RenderTransform>
                                                            </TextBlock>

                                                            <TextBlock Text="{Binding ArtistText}"
                                                                       FontFamily="{StaticResource MGS4TertiaryFont}"
                                                                       FontSize="11"
                                                                       FontWeight="Normal"
                                                                       Foreground="{StaticResource CenterHeaderTextColor}"
                                                                       VerticalAlignment="Center"
                                                                       TextOptions.TextFormattingMode="Ideal"
                                                                       TextOptions.TextRenderingMode="Grayscale"/>
                                                        </Grid>
                                                    </Canvas>
                                                </Grid>

                                                <Grid Grid.Column="2"
                                                      Margin="0,0,10,0"
                                                      VerticalAlignment="Center"
                                                      UseLayoutRounding="False"
                                                      SnapsToDevicePixels="False"
                                                      TextOptions.TextHintingMode="Animated"
                                                      IsHitTestVisible="False">
                                                    <TextBlock Text="{Binding SizeText}"
                                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                                               FontSize="11"
                                                               FontWeight="Normal"
                                                               Foreground="{StaticResource CenterHeaderShadowColor}"
                                                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                                               TextOptions.TextFormattingMode="Ideal"
                                                               TextOptions.TextRenderingMode="Grayscale">
                                                        <TextBlock.RenderTransform>
                                                            <TranslateTransform X="2" Y="2"/>
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>

                                                    <TextBlock Text="{Binding SizeText}"
                                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                                               FontSize="11"
                                                               FontWeight="Normal"
                                                               Foreground="{StaticResource CenterHeaderTextColor}"
                                                               TextOptions.TextFormattingMode="Ideal"
                                                               TextOptions.TextRenderingMode="Grayscale"/>
                                                </Grid>
                                            </Grid>

                                            <Border Grid.Row="0"
                                                    Grid.Column="1"
                                                    BorderBrush="#142114"
                                                    BorderThickness="0,1,0,0"
                                                    IsHitTestVisible="False">
                                                <Border.RenderTransform>
                                                    <TranslateTransform X="-1" Y="2"/>
                                                </Border.RenderTransform>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0"
                                                                         EndPoint="0,1">
                                                        <GradientStop Color="#80142014" Offset="0"/>
                                                        <GradientStop Color="#204A5540" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>

                                                <Grid x:Name="TrackTitleViewport"
                                                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      ClipToBounds="True"
                                                      UseLayoutRounding="False"
                                                      SnapsToDevicePixels="False"
                                                      TextOptions.TextHintingMode="Animated"
                                                      Loaded="TrackTitleViewport_Loaded"
                                                      SizeChanged="TrackTitleViewport_SizeChanged"
                                                      Unloaded="TrackTitleViewport_Unloaded">

                                                    <Canvas x:Name="TrackTitleCanvas"
                                                            ClipToBounds="True">
                                                    <Grid x:Name="TrackTitleTextHost"
                                                          Height="{Binding ActualHeight, ElementName=TrackTitleCanvas}"
                                                          Canvas.Left="3"
                                                          Canvas.Top="0"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="{StaticResource MGS4TertiaryFont}"
                                                                   FontSize="12"
                                                                   FontWeight="Normal"
                                                                   Foreground="{StaticResource CenterHeaderShadowColor}"
                                                                   Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                                                   VerticalAlignment="Center"
                                                                   TextOptions.TextFormattingMode="Ideal"
                                                                   TextOptions.TextRenderingMode="Grayscale">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform X="2"
                                                                                    Y="2"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>

                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="{StaticResource MGS4TertiaryFont}"
                                                                   FontSize="12"
                                                                   FontWeight="Normal"
                                                                   Foreground="{StaticResource CenterHeaderTextColor}"
                                                                   VerticalAlignment="Center"
                                                                   TextOptions.TextFormattingMode="Ideal"
                                                                   TextOptions.TextRenderingMode="Grayscale"/>
                                                    </Grid>
                                                    </Canvas>

                                                </Grid>
                                            </Border>
                                        </Grid>

                                    </Grid>
                                </DataTemplate>

                            </Grid.Resources>

                            <!-- Top-left label -->
                            <Grid Grid.Row="0"
                                  Margin="7,4,4,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top">

                                <!-- Shadow: matches Information -->
                                <TextBlock Text="TRACKLIST"
                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                           Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                           TextOptions.TextFormattingMode="Display">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- Foreground: same softness as iPod / Information -->
                                <TextBlock Text="TRACKLIST"
                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CenterHeaderTextColor}"
                                           TextOptions.TextFormattingMode="Display">
                                    <TextBlock.Effect>
                                        <BlurEffect Radius="{StaticResource CenterHeaderBlurRadius}"/>
                                    </TextBlock.Effect>
                                </TextBlock>

                            </Grid>

                            <!-- Matching labels on the opposite side of the Tracklist header. -->
                            <StackPanel Grid.Row="0"
                                        Margin="4,4,7,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">

                                <Button Margin="0,0,10,0"
                                        Tag="select_all"
                                        Click="SelectAllTracks_Click"
                                        MouseEnter="TooltipTarget_MouseEnter"
                                        MouseLeave="TooltipTarget_MouseLeave"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Button.Template>

                                <Grid Background="Transparent">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="0.65"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                             Value="True">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <TextBlock Text="ALL"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CenterHeaderShadowColor}"
                                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                               TextOptions.TextFormattingMode="Display">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                Y="{StaticResource CenterHeaderShadowOffset}"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>

                                    <TextBlock Text="ALL"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#62CEE6"
                                               TextOptions.TextFormattingMode="Display">
                                        <TextBlock.Effect>
                                            <BlurEffect Radius="{StaticResource CenterHeaderBlurRadius}"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                                </Button>

                                <Button Click="SelectNoTracks_Click"
                                        Tag="select_none"
                                        MouseEnter="TooltipTarget_MouseEnter"
                                        MouseLeave="TooltipTarget_MouseLeave"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Button.Template>

                                <Grid Background="Transparent">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="0.65"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                             Value="True">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <TextBlock Text="NONE"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CenterHeaderShadowColor}"
                                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                               TextOptions.TextFormattingMode="Display">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                Y="{StaticResource CenterHeaderShadowOffset}"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>

                                    <TextBlock Text="NONE"
                                               FontFamily="{StaticResource MGS4TertiaryFont}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#FC6747"
                                               TextOptions.TextFormattingMode="Display">
                                        <TextBlock.Effect>
                                            <BlurEffect Radius="{StaticResource CenterHeaderBlurRadius}"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                                </Button>

                            </StackPanel>

                            <!-- Dynamic album/podcast tabs for the selected category. -->
                            <ListBox x:Name="TrackTabsList"
                                     Grid.Row="1"
                                     Margin="-1,4,0,0"
                                     Tag="album_tabs"
                                     SelectedIndex="0"
                                     SelectionChanged="TrackTabsList_SelectionChanged"
                                     PreviewMouseLeftButtonDown="TrackTabsList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="TrackTabsList_PreviewMouseMove"
                                     PreviewMouseLeftButtonUp="TrackTabsList_PreviewMouseLeftButtonUp"
                                     LostMouseCapture="TrackTabsList_LostMouseCapture"
                                     MouseEnter="TrackTabsList_MouseEnter"
                                     MouseLeave="TrackTabsList_MouseLeave"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Bottom"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False"
                                     ItemContainerStyle="{StaticResource TrackListTabStyle}">

                                <!-- Edge fades are applied dynamically only when tabs are obscured. -->

                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                            </ListBox>

                            <!-- Full-width divider directly beneath the tab strip. -->
                            <Border x:Name="TrackTabsDividerSoft"
                                    Grid.Row="1"
                                    VerticalAlignment="Bottom"
                                    BorderBrush="{StaticResource CenterContentBorderColor}"
                                    BorderThickness="0,0,0,1"
                                    Opacity="{StaticResource CenterContentBorderSoftOpacity}"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <BlurEffect Radius="{StaticResource CenterContentBorderBlurRadius}"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="TrackTabsDividerCrisp"
                                    Grid.Row="1"
                                    VerticalAlignment="Bottom"
                                    BorderBrush="{StaticResource CenterContentBorderColor}"
                                    BorderThickness="0,0,0,1"
                                    IsHitTestVisible="False"/>

                            <!-- Inner track-list column. Borderless and marginless by design. -->
                            <Grid Grid.Row="2"
                                  Background="Transparent"
                                  ClipToBounds="True">

                                <!-- Live track list for the currently selected ALL/album/podcast tab.
                                     The ScrollViewer provides smooth pixel-based vertical drag scrolling
                                     plus a minimal pale rectangular scrollbar when the list overflows. -->
                                <ScrollViewer x:Name="TrackItemsScrollViewer"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalContentAlignment="Stretch"
                                              ScrollChanged="TrackItemsScrollViewer_ScrollChanged"
                                              PreviewMouseLeftButtonDown="TrackItemsScrollViewer_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="TrackItemsScrollViewer_PreviewMouseMove"
                                              PreviewMouseLeftButtonUp="TrackItemsScrollViewer_PreviewMouseLeftButtonUp"
                                              LostMouseCapture="TrackItemsScrollViewer_LostMouseCapture">

                                    <!-- Tracklist-only scrollbar styling: translucent black rail, square pale thumb, no arrows. -->
                                    <ScrollViewer.Resources>
                                        <Style TargetType="{x:Type ScrollBar}">
                                            <Setter Property="Width" Value="5"/>
                                            <Setter Property="Margin" Value="0,5,5,5"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                        <!-- WPF reserves a system-width scrollbar slot internally.
                                                             Keep that slot untouched, but render the custom 5px lane at
                                                             the same right edge and scale only its horizontal appearance
                                                             to 95%. This produces a 4.75px pale thumb and an 8.55px rail
                                                             without changing their established right-side position. -->
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <Grid Width="5"
                                                                  HorizontalAlignment="Right"
                                                                  RenderTransformOrigin="1,0.5">
                                                                <Grid.RenderTransform>
                                                                    <ScaleTransform ScaleX="0.95"/>
                                                                </Grid.RenderTransform>

                                                                <!-- Keep the horizontal overhang scaled with the rail.
                                                                     The rail top aligns with the first track's 5px top offset. -->
                                                                <Border Margin="-3,0,-1,-3"
                                                                        Background="#66000000"
                                                                        IsHitTestVisible="False"/>

                                                                <Track x:Name="PART_Track"
                                                                       Orientation="Vertical"
                                                                       IsDirectionReversed="True"
                                                                       Margin="0,3,0,0"
                                                                       Focusable="False">
                                                                    <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                                      Background="Transparent"
                                                                                      BorderThickness="0"
                                                                                      Focusable="False"
                                                                                      IsTabStop="False"
                                                                                      Opacity="0"/>
                                                                    </Track.DecreaseRepeatButton>

                                                                    <Track.Thumb>
                                                                        <Thumb MinHeight="20"
                                                                               Background="{StaticResource CenterHeaderTextColor}"
                                                                               Focusable="False">
                                                                            <Thumb.Template>
                                                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                                                    <Border Background="{TemplateBinding Background}"
                                                                                            SnapsToDevicePixels="True"/>
                                                                                </ControlTemplate>
                                                                            </Thumb.Template>
                                                                        </Thumb>
                                                                    </Track.Thumb>

                                                                    <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                                      Background="Transparent"
                                                                                      BorderThickness="0"
                                                                                      Focusable="False"
                                                                                      IsTabStop="False"
                                                                                      Opacity="0"/>
                                                                    </Track.IncreaseRepeatButton>
                                                                </Track>
                                                            </Grid>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ScrollViewer.Resources>

                                    <ItemsControl x:Name="TrackItemsList"
                                                  ItemTemplate="{StaticResource TrackListItemTemplate}"
                                                  Margin="0,0,0,5"
                                                  HorizontalContentAlignment="Stretch">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>

                                </ScrollViewer>

                                <Grid x:Name="NoTrackDataMessage"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      IsHitTestVisible="False"
                                      UseLayoutRounding="False"
                                      SnapsToDevicePixels="False"
                                      TextOptions.TextHintingMode="Animated">
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="-24"/>
                                    </Grid.RenderTransform>

                                    <Rectangle Width="36"
                                               Height="144"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Fill="#FC6747"
                                               Opacity="0.5"
                                               UseLayoutRounding="False"
                                               SnapsToDevicePixels="False"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               RenderOptions.EdgeMode="Unspecified"
                                               IsHitTestVisible="False">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://application:,,,/Assets/Images/icon_exclamation_point.png"
                                                        Stretch="Uniform"
                                                        AlignmentX="Center"
                                                        AlignmentY="Center"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>

                                    <TextBlock Text="NO  DATA  AVAILABLE"
                                               FontFamily="{StaticResource MGS4PrimaryFont}"
                                               FontSize="15"
                                               FontWeight="Normal"
                                               Foreground="{StaticResource CenterHeaderShadowColor}"
                                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Ideal"
                                               TextOptions.TextRenderingMode="Grayscale">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="2" Y="2"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>

                                    <TextBlock Text="NO  DATA  AVAILABLE"
                                               FontFamily="{StaticResource MGS4PrimaryFont}"
                                               FontSize="15"
                                               FontWeight="Normal"
                                               Foreground="{StaticResource CenterHeaderTextColor}"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Ideal"
                                               TextOptions.TextRenderingMode="Grayscale"/>
                                </Grid>

                            </Grid>

                        </Grid>

                        <Grid x:Name="StartupLoadingIndicator"
                              Grid.ColumnSpan="2"
                              Panel.ZIndex="30"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Visibility="Collapsed"
                              UseLayoutRounding="False"
                              SnapsToDevicePixels="False">
                            <Grid Width="360"
                                  Height="200"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Rectangle Width="200"
                                           Height="200"
                                           HorizontalAlignment="Center"
                                           Fill="{StaticResource CenterHeaderTextColor}"
                                           Opacity="0.5"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderOptions.EdgeMode="Unspecified"
                                           UseLayoutRounding="False"
                                           SnapsToDevicePixels="False"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Images/icon_loading.png"
                                                    Stretch="Uniform"
                                                    AlignmentX="Center"
                                                    AlignmentY="Center"/>
                                    </Rectangle.OpacityMask>
                                    <Rectangle.RenderTransform>
                                        <RotateTransform x:Name="StartupLoadingIconRotation" Angle="0"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>

                                <StackPanel Width="360"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="LOADING DATA"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Center"
                                               FontFamily="{StaticResource MGS4PrimaryFont}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#FF8C8C"
                                               TextOptions.TextFormattingMode="Display"/>
                                    <TextBlock x:Name="StartupLoadingPercentageText"
                                               Text="0%"
                                               Margin="0,1,0,0"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Center"
                                               FontFamily="{StaticResource MGS4PrimaryFont}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CenterHeaderTextColor}"
                                               TextOptions.TextFormattingMode="Display"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                    </Grid>

                </Grid>

                <!-- Last-hovered track filename, using the category item title style. -->
                <Grid Grid.Row="1"
                      Margin="6,-5,6,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      IsHitTestVisible="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="HoveredFilenameViewport"
                          Grid.Column="1"
                          Height="20"
                          Margin="5,0,8,0"
                          Tag="filename"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          ClipToBounds="True"
                          UseLayoutRounding="False"
                          SnapsToDevicePixels="False"
                          TextOptions.TextHintingMode="Animated"
                          Loaded="TrackTitleViewport_Loaded"
                          SizeChanged="TrackTitleViewport_SizeChanged"
                          Unloaded="TrackTitleViewport_Unloaded"
                          MouseEnter="TooltipTarget_MouseEnter"
                          MouseLeave="TooltipTarget_MouseLeave">
                        <Canvas x:Name="HoveredFilenameCanvas"
                                ClipToBounds="True">
                            <Grid x:Name="HoveredFilenameTextHost"
                                  Height="{Binding ActualHeight, ElementName=HoveredFilenameCanvas}"
                                  Canvas.Left="3"
                                  Canvas.Top="0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                                <TextBlock Text="{Binding HoveredTrackFileName, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                           Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                           VerticalAlignment="Center"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <TextBlock Text="{Binding HoveredTrackFileName, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderTextColor}"
                                           VerticalAlignment="Center"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale"/>
                            </Grid>
                        </Canvas>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="6,16,6,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      IsHitTestVisible="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1"
                          Margin="9,0,8,0"
                          Tag="waveform"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Opacity="1"
                          UseLayoutRounding="False"
                          SnapsToDevicePixels="False"
                          TextOptions.TextHintingMode="Animated"
                          MouseEnter="TooltipTarget_MouseEnter"
                          MouseLeave="TooltipTarget_MouseLeave">
                        <TextBlock Text="WAVEFORM"
                                   FontFamily="{StaticResource MGS4PrimaryFont}"
                                   FontSize="11"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource CenterHeaderShadowColor}"
                                   Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="Grayscale">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                    Y="{StaticResource CenterHeaderShadowOffset}"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock Text="WAVEFORM"
                                   FontFamily="{StaticResource MGS4PrimaryFont}"
                                   FontSize="11"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource CenterHeaderTextColor}"
                                   Opacity="1"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="Grayscale"/>
                    </Grid>
                </Grid>

                <!-- Information-side detail section beneath the hovered filename. -->
                <Grid Grid.Row="1"
                      Margin="6,24,6,30"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      IsHitTestVisible="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25*"/>
                        <RowDefinition Height="75*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Margin="20,10,20,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="{StaticResource CenterHeaderTextColor}"
                            BorderThickness="2,0,0,2"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect Color="#F3F3CF"
                                              Direction="90"
                                              ShadowDepth="4"
                                              BlurRadius="8"
                                              Opacity="0.5"/>
                        </Border.Effect>
                    </Border>

                    <Border x:Name="WaveformContainer"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="20,10,20,0"
                            Tag="waveform"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="{StaticResource CenterHeaderTextColor}"
                            BorderThickness="2,0,0,2"
                            MouseEnter="TooltipTarget_MouseEnter"
                            MouseLeave="TooltipTarget_MouseLeave">
                        <Grid ClipToBounds="True">
                            <Rectangle Fill="#0AF3F3CF"
                                       IsHitTestVisible="False"/>

                            <Grid x:Name="WaveformDrawingSurface"
                                  Margin="0"
                                  ClipToBounds="True"
                                  SizeChanged="WaveformDrawingSurface_SizeChanged">
                                <Image x:Name="WaveformImage"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       IsHitTestVisible="False"/>
                            </Grid>

                            <Grid x:Name="WaveformNoDataMessage"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  UseLayoutRounding="False"
                                  SnapsToDevicePixels="False"
                                  TextOptions.TextHintingMode="Animated">
                                <Grid.RenderTransform>
                                    <TranslateTransform Y="-5"/>
                                </Grid.RenderTransform>
                                <TextBlock Text="NO TRACK SELECTED"
                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                           FontSize="11"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                           Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                           VerticalAlignment="Center"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="2" Y="2"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <TextBlock Text="NO TRACK SELECTED"
                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                           FontSize="11"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderTextColor}"
                                           VerticalAlignment="Center"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale"/>
                            </Grid>

                            <Grid x:Name="DurationValueGrid"
                                  Visibility="Collapsed"
                                  Margin="0,0,0,2"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  UseLayoutRounding="False"
                                  SnapsToDevicePixels="False"
                                  TextOptions.TextHintingMode="Animated">
                                <TextBlock Text="{Binding HoveredTrackDuration, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                           FontSize="9"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                           Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding HoveredTrackDuration, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                           FontSize="9"
                                           FontWeight="Normal"
                                           Foreground="#FF8C8C"
                                           Opacity="1"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="0"
                          Grid.Column="1"
                          Margin="5,8,0,0"
                          Tag="waveform"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Opacity="1"
                          UseLayoutRounding="False"
                          SnapsToDevicePixels="False"
                          TextOptions.TextHintingMode="Animated"
                          IsHitTestVisible="True"
                          MouseEnter="TooltipTarget_MouseEnter"
                          MouseLeave="TooltipTarget_MouseLeave">
                        <Grid.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </Grid.LayoutTransform>

                        <TextBlock Text="Amplitude"
                                   FontFamily="{StaticResource MGS4PrimaryFont}"
                                   FontSize="9"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource CenterHeaderShadowColor}"
                                   Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="Grayscale">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="-3"
                                                    Y="{StaticResource CenterHeaderShadowOffset}"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock Text="Amplitude"
                                   FontFamily="{StaticResource MGS4PrimaryFont}"
                                   FontSize="9"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource CenterHeaderTextColor}"
                                   Opacity="1"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="Grayscale"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          Grid.Column="1"
                          Margin="10,0,0,0"
                          Tag="waveform"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Opacity="1"
                          UseLayoutRounding="False"
                          SnapsToDevicePixels="False"
                          TextOptions.TextHintingMode="Animated"
                          MouseEnter="TooltipTarget_MouseEnter"
                          MouseLeave="TooltipTarget_MouseLeave">
                        <TextBlock Text="0"
                                   FontFamily="{StaticResource MGS4PrimaryFont}"
                                   FontSize="9"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource CenterHeaderShadowColor}"
                                   Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="Grayscale">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                    Y="{StaticResource CenterHeaderShadowOffset}"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock Text="0"
                                   FontFamily="{StaticResource MGS4PrimaryFont}"
                                   FontSize="9"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource CenterHeaderTextColor}"
                                   Opacity="1"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="Grayscale"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          Grid.Column="1"
                          Margin="20,0,20,0"
                          Tag="waveform"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Opacity="1"
                          UseLayoutRounding="False"
                          SnapsToDevicePixels="False"
                          TextOptions.TextHintingMode="Animated"
                          MouseEnter="TooltipTarget_MouseEnter"
                          MouseLeave="TooltipTarget_MouseLeave">
                        <TextBlock Text="Duration"
                                   FontFamily="{StaticResource MGS4PrimaryFont}"
                                   FontSize="9"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource CenterHeaderShadowColor}"
                                   Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="Grayscale">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                    Y="{StaticResource CenterHeaderShadowOffset}"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock Text="Duration"
                                   FontFamily="{StaticResource MGS4PrimaryFont}"
                                   FontSize="9"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource CenterHeaderTextColor}"
                                   Opacity="1"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="Grayscale"/>
                    </Grid>

                    <ScrollViewer x:Name="InformationScrollViewer"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="20,25,20,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          IsHitTestVisible="True">
                      <Grid Margin="0,0,0,4">
                        <Grid.Resources>
                            <Style x:Key="InformationFieldHeaderStyle"
                                   TargetType="{x:Type ContentControl}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ContentControl}">
                                            <Grid UseLayoutRounding="False"
                                                  SnapsToDevicePixels="False"
                                                  TextOptions.TextHintingMode="Animated">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                                           FontSize="8"
                                                           FontWeight="Normal"
                                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                                           Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                                           TextOptions.TextFormattingMode="Ideal"
                                                           TextOptions.TextRenderingMode="Grayscale">
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                                           FontSize="8"
                                                           FontWeight="Normal"
                                                           Foreground="{StaticResource CenterHeaderTextColor}"
                                                           Opacity="1"
                                                           TextOptions.TextFormattingMode="Ideal"
                                                           TextOptions.TextRenderingMode="Grayscale"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="InformationFieldBodyStyle"
                                   TargetType="{x:Type ContentControl}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ContentControl}">
                                            <Grid UseLayoutRounding="False"
                                                  SnapsToDevicePixels="False"
                                                  TextOptions.TextHintingMode="Animated">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                                           FontSize="9"
                                                           FontWeight="Normal"
                                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                                           Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                                           TextWrapping="NoWrap"
                                                           TextOptions.TextFormattingMode="Ideal"
                                                           TextOptions.TextRenderingMode="Grayscale">
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                                           FontSize="9"
                                                           FontWeight="Normal"
                                                           Foreground="{StaticResource CenterHeaderTextColor}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextOptions.TextFormattingMode="Ideal"
                                                           TextOptions.TextRenderingMode="Grayscale"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15"
                                    Tag="codec" MouseEnter="TooltipTarget_MouseEnter" MouseLeave="TooltipTarget_MouseLeave">
                            <ContentControl Content="CODEC" Style="{StaticResource InformationFieldHeaderStyle}"/>
                            <ContentControl Content="{Binding HoveredTrackCodec, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Style="{StaticResource InformationFieldBodyStyle}"/>
