        <!-- ========================================================= -->
        <!-- RIGHT COLUMN                                              -->
        <!-- ========================================================= -->

        <Grid Grid.Column="4"
              ClipToBounds="True">

            <!-- Fade toward right -->
            <Grid.OpacityMask>

                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">

                    <GradientStop Color="#FFFFFFFF"
                                  Offset="0"/>

                    <GradientStop Color="#FFFFFFFF"
                                  Offset="0.75"/>

                    <GradientStop Color="#00FFFFFF"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Grid.OpacityMask>


            <!-- Panel background + transparent holes -->
            <Path Data="{StaticResource RightPanelGeometry}"
                  Stretch="Fill"
                  Fill="{StaticResource SideBackground}"
                  IsHitTestVisible="False"/>

            <!-- Vertical darkness overlay -->
            <Path Data="{StaticResource RightPanelGeometry}"
                  Stretch="Fill"
                  Fill="{StaticResource ColumnDarknessOverlay}"
                  IsHitTestVisible="False"/>

            <!-- Grid above the darkness overlay -->
            <Path Data="{StaticResource RightPanelGeometry}"
                  Stretch="Fill"
                  Fill="{StaticResource CenterGridPattern}"
                  IsHitTestVisible="False"/>


            <!-- Outer border: top, left, bottom only -->
            <Border BorderBrush="{StaticResource PanelBorderColor}"
                    BorderThickness="2,2,0,2"
                    CornerRadius="2"
                    IsHitTestVisible="False"/>


            <!-- Outer inner glow -->
            <Border BorderBrush="{StaticResource GlowColor}"
                    BorderThickness="2,2,0,2"
                    CornerRadius="2"
                    Margin="1,1,0,1"
                    IsHitTestVisible="False">

                <Border.Effect>
                    <DropShadowEffect Color="White"
                                      ShadowDepth="0"
                                      BlurRadius="5"
                                      Opacity="0.10"/>
                </Border.Effect>

            </Border>


            <!-- ===================================================== -->
            <!-- RIGHT HOLE BORDERS                                    -->
            <!-- ===================================================== -->

            <!-- Soft same-color underlay -->
            <Grid IsHitTestVisible="False"
                  UseLayoutRounding="False"
                  SnapsToDevicePixels="False">

                <Grid.RowDefinitions>

                    <RowDefinition Height="5.4*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="86.8*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="5.4*"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>

                    <!-- Inner-edge gap: 11.5% -->
                    <ColumnDefinition Width="11.5*"/>

                    <!-- Hole: 7.0% -->
                    <ColumnDefinition Width="7.0*"/>

                    <!-- 81.5% -->
                    <ColumnDefinition Width="81.5*"/>

                </Grid.ColumnDefinitions>


                <!-- Top hole -->
                <Rectangle Grid.Row="1"
                           Grid.Column="1"
                           Fill="Transparent"
                           Stroke="{StaticResource HoleBorderColor}"
                           StrokeThickness="{StaticResource HoleBorderSoftThickness}"
                           Opacity="{StaticResource HoleBorderSoftOpacity}">

                    <Rectangle.Effect>
                        <BlurEffect Radius="{StaticResource HoleBorderSoftBlurRadius}"/>
                    </Rectangle.Effect>

                </Rectangle>


                <!-- Bottom hole -->
                <Rectangle Grid.Row="3"
                           Grid.Column="1"
                           Fill="Transparent"
                           Stroke="{StaticResource HoleBorderColor}"
                           StrokeThickness="{StaticResource HoleBorderSoftThickness}"
                           Opacity="{StaticResource HoleBorderSoftOpacity}">

                    <Rectangle.Effect>
                        <BlurEffect Radius="{StaticResource HoleBorderSoftBlurRadius}"/>
                    </Rectangle.Effect>

                </Rectangle>

            </Grid>


            <!-- Crisp hole edge -->
            <Grid IsHitTestVisible="False"
                  UseLayoutRounding="False"
                  SnapsToDevicePixels="False">

                <Grid.RowDefinitions>
                    <RowDefinition Height="5.4*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="86.8*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="5.4*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11.5*"/>
                    <ColumnDefinition Width="7.0*"/>
                    <ColumnDefinition Width="81.5*"/>
                </Grid.ColumnDefinitions>


                <Rectangle Grid.Row="1"
                           Grid.Column="1"
                           Fill="Transparent"
                           Stroke="{StaticResource HoleBorderColor}"
                           StrokeThickness="{StaticResource HoleBorderThickness}"/>


                <Rectangle Grid.Row="3"
                           Grid.Column="1"
                           Fill="Transparent"
                           Stroke="{StaticResource HoleBorderColor}"
                           StrokeThickness="{StaticResource HoleBorderThickness}"/>

            </Grid>


            <!-- Side label -->
            <Grid IsHitTestVisible="False">

                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="1.4*"/>
                    <RowDefinition Height="87.2*"/>
                    <RowDefinition Height="1.4*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="70*"/>
                </Grid.ColumnDefinitions>


                <!-- Counterclockwise -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="{StaticResource RightSideLabel}"
                           FontFamily="{StaticResource MGS4PrimaryFont}"
                           FontSize="{StaticResource SideLabelFontSize}"
                           Foreground="{StaticResource SideLabelColor}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"
                           Margin="4,0,0,0"
                           Padding="0"
                           TextOptions.TextFormattingMode="Display">

                    <TextBlock.Effect>
                        <BlurEffect Radius="{StaticResource SideLabelBlurRadius}"/>
                    </TextBlock.Effect>

                    <TextBlock.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.05" ScaleY="1"/>
                            <RotateTransform Angle="-90"/>
                        </TransformGroup>
                    </TextBlock.LayoutTransform>

                </TextBlock>

            </Grid>

        </Grid>

        <!-- Transfer modal shield and empty transfer window. -->
        <Border x:Name="TransferInputShield"
                Grid.Column="0" Grid.ColumnSpan="5"
                Panel.ZIndex="99"
                Background="Transparent"
                Focusable="True"
                Visibility="{Binding Visibility, ElementName=TransferOverlay}"
                PreviewMouseWheel="TransferInputShield_PreviewMouseWheel"/>

        <Grid x:Name="TransferOverlay"
              Grid.Column="0" Grid.ColumnSpan="5"
              Panel.ZIndex="100"
              Width="384" Height="216"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="Transparent"
              RenderTransformOrigin="0.5,0.5"
              UseLayoutRounding="False"
              SnapsToDevicePixels="False"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="TransferOverlayScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="TransferOverlayTranslation" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="1"/>
            </Grid.CacheMode>
            <Grid.Resources>
                <Style x:Key="TransferDecisionButtonStyle" TargetType="{x:Type Button}">
                    <Setter Property="Width" Value="110"/>
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid Background="Transparent">
                                    <Border CornerRadius="2">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#BF142014" Offset="0"/>
                                                <GradientStop Color="#604A5540" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <Border x:Name="HoverHighlight"
                                            CornerRadius="2"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0094A48A" Offset="0"/>
                                                <GradientStop Color="#FF94A48A" Offset="0.0075"/>
                                                <GradientStop Color="#FF94A48A" Offset="0.9925"/>
                                                <GradientStop Color="#0094A48A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <Border Background="Transparent"
                                            BorderBrush="{StaticResource CenterContentBorderColor}"
                                            BorderThickness="{StaticResource CenterContentBorderThickness}"
                                            CornerRadius="2"
                                            Opacity="{StaticResource CenterContentBorderSoftOpacity}"
                                            IsHitTestVisible="False">
                                        <Border.Effect>
                                            <BlurEffect Radius="{StaticResource CenterContentBorderBlurRadius}"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border Background="Transparent"
                                            BorderBrush="{StaticResource CenterContentBorderColor}"
                                            BorderThickness="{StaticResource CenterContentBorderThickness}"
                                            CornerRadius="2"
                                            IsHitTestVisible="False"/>

                                    <Grid HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          UseLayoutRounding="False"
                                          SnapsToDevicePixels="False"
                                          TextOptions.TextHintingMode="Animated">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   FontFamily="{StaticResource MGS4PrimaryFont}"
                                                   FontSize="11"
                                                   FontWeight="Normal"
                                                   Foreground="{StaticResource CenterHeaderShadowColor}"
                                                   Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                                   TextOptions.TextFormattingMode="Ideal"
                                                   TextOptions.TextRenderingMode="Grayscale">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                                    Y="{StaticResource CenterHeaderShadowOffset}"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   FontFamily="{StaticResource MGS4PrimaryFont}"
                                                   FontSize="11"
                                                   FontWeight="Normal"
                                                   Foreground="{StaticResource CenterHeaderTextColor}"
                                                   TextOptions.TextFormattingMode="Ideal"
                                                   TextOptions.TextRenderingMode="Grayscale"/>
                                    </Grid>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames
                                                        Storyboard.TargetName="HoverHighlight"
                                                        Storyboard.TargetProperty="Opacity"
                                                        RepeatBehavior="Forever">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.306"/>
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0.34"/>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.17">
                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseIn"/>
                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                        </EasingDoubleKeyFrame>
                                                        <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.306"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverHighlight"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Border CornerRadius="2" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E6142014" Offset="0"/>
                        <GradientStop Color="#BF4A5540" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border x:Name="TransferOverlayOuterBorder"
                    Background="Transparent" BorderThickness="2"
                    CornerRadius="2" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="TransferOverlayBorderBrush" Color="#94A48A"/>
                </Border.BorderBrush>
            </Border>

            <Border x:Name="TransferOverlayGlowBorder"
                    Background="Transparent"
                    BorderBrush="{StaticResource GlowColor}"
                    BorderThickness="2" CornerRadius="2" Margin="1"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="White" ShadowDepth="0"
                                      BlurRadius="5" Opacity="0.10"/>
                </Border.Effect>
            </Border>

            <StackPanel Margin="0,25,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False">
                <Grid x:Name="TransferHeaderContainer"
                      HorizontalAlignment="Center"
                      UseLayoutRounding="False"
                      SnapsToDevicePixels="False"
                      TextOptions.TextHintingMode="Animated">
                    <ItemsControl x:Name="TransferHeaderShadowText"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Opacity="0.35">
                        <ItemsControl.RenderTransform>
                            <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                Y="{StaticResource CenterHeaderShadowOffset}"/>
                        </ItemsControl.RenderTransform>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                           FontSize="19"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                           Margin="{StaticResource CenterHeaderCharacterSpacing}"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="TransferHeaderText"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                           FontSize="19"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderTextColor}"
                                           Margin="{StaticResource CenterHeaderCharacterSpacing}"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid x:Name="TransferBodyContainer"
                      Margin="0,22,0,0"
                      HorizontalAlignment="Center"
                      UseLayoutRounding="False"
                      SnapsToDevicePixels="False"
                      TextOptions.TextHintingMode="Animated">
                    <TextBlock x:Name="TransferBodyShadowText"
                               Width="330"
                               FontFamily="{StaticResource MGS4TertiaryFont}"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{StaticResource CenterHeaderShadowColor}"
                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Grayscale">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="2" Y="2"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="TransferBodyText"
                               Width="330"
                               FontFamily="{StaticResource MGS4TertiaryFont}"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{StaticResource CenterHeaderTextColor}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Grayscale"/>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="TransferDecisionButtons"
                        Margin="0,0,0,25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                <Button x:Name="TransferYesButton"
                        Content="YES"
                        Margin="0,0,6,0"
                        Style="{StaticResource TransferDecisionButtonStyle}"
                        MouseEnter="MenuSelectSound_MouseEnter"
                        Click="TransferYesButton_Click"/>
                <Button x:Name="TransferNoButton"
                        Content="NO"
                        Margin="6,0,0,0"
                        Style="{StaticResource TransferDecisionButtonStyle}"
                        MouseEnter="MenuSelectSound_MouseEnter"
                        Click="CloseTransferOverlay_Click"/>
            </StackPanel>

            <Button x:Name="TransferCancelButton"
                    Content="CANCEL"
                    Width="232"
                    Margin="0,0,0,25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"
                    Opacity="0"
                    Style="{StaticResource TransferDecisionButtonStyle}"
                    MouseEnter="MenuSelectSound_MouseEnter"
                    Click="CloseTransferOverlay_Click"/>

            <Grid x:Name="TransferLoadingIndicator"
                  Width="150" Height="94.64"
                  Margin="0,0,0,57.68"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  UseLayoutRounding="False"
                  SnapsToDevicePixels="False"
                  IsHitTestVisible="False"
                  Opacity="0"
                  Visibility="Collapsed">
                <Rectangle x:Name="TransferLoadingIcon"
                           Width="60" Height="60"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Fill="{StaticResource CenterHeaderTextColor}"
                           Opacity="0.5"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderOptions.EdgeMode="Unspecified"
                           UseLayoutRounding="False"
                           SnapsToDevicePixels="False"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/Images/icon_loading.png"
                                    Stretch="Uniform"
                                    AlignmentX="Center"
                                    AlignmentY="Center"/>
                    </Rectangle.OpacityMask>
                    <Rectangle.RenderTransform>
                        <RotateTransform x:Name="TransferLoadingIconRotation" Angle="0"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      TextOptions.TextHintingMode="Animated">
                        <TextBlock x:Name="TransferLoadingProgressText"
                                    Text="0%"
                                   Width="130"
                                   Padding="10"
                                   TextAlignment="Center"
                               Margin="0"
                               FontFamily="{StaticResource MGS4PrimaryFont}"
                               FontSize="22.5"
                               FontWeight="Bold"
                               Foreground="#FF8C8C"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Effect>
                            <BlurEffect Radius="{StaticResource CenterHeaderBlurRadius}"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Grid>

            <Grid x:Name="TransferSuccessIndicator"
                  Width="72" Height="72"
                  Margin="0,10,0,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  Visibility="Collapsed">
                <Rectangle Width="64" Height="64"
                           Fill="#FFBD63"
                           UseLayoutRounding="False"
                           SnapsToDevicePixels="False"
                           RenderOptions.BitmapScalingMode="HighQuality">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="Assets/Images/icon_ipod.png"
                                    Stretch="Uniform"
                                    AlignmentX="Center"
                                    AlignmentY="Center"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Width="20" Height="20"
                           Fill="#62CEE6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           UseLayoutRounding="False"
                           SnapsToDevicePixels="False"
                           RenderOptions.BitmapScalingMode="HighQuality">
                    <Rectangle.RenderTransform>
                        <TranslateTransform Y="-13"/>
                    </Rectangle.RenderTransform>
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="Assets/Images/icon_checkmark.png"
                                    Stretch="Uniform"
                                    AlignmentX="Center"
                                    AlignmentY="Center"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>

        </Grid>

        <!-- Modal error overlay. -->
        <Border x:Name="ErrorInputShield"
                Grid.Column="0" Grid.ColumnSpan="5"
                Panel.ZIndex="101"
                Background="Transparent"
                Focusable="True"
                Visibility="{Binding Visibility, ElementName=ErrorOverlay}"
                PreviewMouseWheel="ErrorInputShield_PreviewMouseWheel"/>

        <Grid x:Name="ErrorOverlay"
              Grid.Column="0" Grid.ColumnSpan="5"
              Panel.ZIndex="102"
              Width="384" Height="248"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="Transparent"
              RenderTransformOrigin="0.5,0.5"
              UseLayoutRounding="False"
              SnapsToDevicePixels="False"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ErrorOverlayScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="ErrorOverlayTranslation" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="1"/>
            </Grid.CacheMode>

            <Border CornerRadius="2" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E6142014" Offset="0"/>
                        <GradientStop Color="#BF4A5540" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border x:Name="ErrorOverlayOuterBorder"
                    Background="Transparent" BorderThickness="2"
                    CornerRadius="2" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="ErrorOverlayBorderBrush" Color="#94A48A"/>
                </Border.BorderBrush>
            </Border>
            <Border x:Name="ErrorOverlayGlowBorder"
                    Background="Transparent" BorderBrush="{StaticResource GlowColor}"
                    BorderThickness="2" CornerRadius="2" Margin="1"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="White" ShadowDepth="0"
                                      BlurRadius="5" Opacity="0.10"/>
                </Border.Effect>
            </Border>

            <Grid Margin="0,25,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  IsHitTestVisible="False"
                  TextOptions.TextHintingMode="Animated">
                <TextBlock Text="ERROR"
                           FontFamily="{StaticResource MGS4PrimaryFont}"
                           FontSize="19" FontWeight="Normal"
                           Foreground="{StaticResource CenterHeaderShadowColor}"
                           Opacity="0.35"
                           TextOptions.TextFormattingMode="Ideal"
                           TextOptions.TextRenderingMode="Grayscale">
                    <TextBlock.RenderTransform>
                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Text="ERROR"
                           FontFamily="{StaticResource MGS4PrimaryFont}"
                           FontSize="19" FontWeight="Normal"
                           Foreground="{StaticResource CenterHeaderTextColor}"
                           TextOptions.TextFormattingMode="Ideal"
                           TextOptions.TextRenderingMode="Grayscale"/>
            </Grid>

            <Grid Width="330" Height="152"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  TextOptions.TextHintingMode="Animated">
                <Grid.RenderTransform>
                    <TranslateTransform Y="-5"/>
                </Grid.RenderTransform>
                <Rectangle x:Name="ErrorIcon"
                           Width="128" Height="128"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           Fill="#FC6747"
                           Opacity="0.7"
                           UseLayoutRounding="False"
                           SnapsToDevicePixels="False"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderOptions.EdgeMode="Unspecified"
                           IsHitTestVisible="False">
                    <Rectangle.OpacityMask>
                        <ImageBrush x:Name="ErrorIconMaskBrush"
                                    ImageSource="pack://application:,,,/Assets/Images/icon_exclamation_point.png"
                                    Stretch="Uniform"
                                    AlignmentX="Center"
                                    AlignmentY="Center"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock x:Name="ErrorMessageShadowText"
                           Width="310"
                           FontFamily="{StaticResource MGS4TertiaryFont}"
                           FontSize="12" FontWeight="Normal"
                           Foreground="{StaticResource CenterHeaderShadowColor}"
                           Opacity="{StaticResource InformationHeaderShadowOpacity}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="15"
                           LineStackingStrategy="BlockLineHeight"
                           TextOptions.TextFormattingMode="Ideal"
                           TextOptions.TextRenderingMode="Grayscale">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="ErrorMessageShadowTranslation" X="2" Y="-7"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="ErrorMessageText"
                           Width="310"
                           FontFamily="{StaticResource MGS4TertiaryFont}"
                           FontSize="12" FontWeight="Normal"
                           Foreground="{StaticResource CenterHeaderTextColor}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="15"
                           LineStackingStrategy="BlockLineHeight"
                           TextOptions.TextFormattingMode="Ideal"
                           TextOptions.TextRenderingMode="Grayscale">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="ErrorMessageTranslation" Y="-9"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <Button Content="OK"
                    Width="232" Height="34"
                    Margin="0,0,0,18"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Focusable="False"
                    MouseEnter="MenuSelectSound_MouseEnter"
                    Click="CloseErrorOverlay_Click">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#BF142014" Offset="0"/>
                                        <GradientStop Color="#604A5540" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="HoverHighlight"
                                    CornerRadius="2"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0094A48A" Offset="0"/>
                                        <GradientStop Color="#FF94A48A" Offset="0.0075"/>
                                        <GradientStop Color="#FF94A48A" Offset="0.9925"/>
                                        <GradientStop Color="#0094A48A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Background="Transparent"
                                    BorderBrush="{StaticResource CenterContentBorderColor}"
                                    BorderThickness="{StaticResource CenterContentBorderThickness}"
                                    CornerRadius="2"
                                    Opacity="{StaticResource CenterContentBorderSoftOpacity}"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <BlurEffect Radius="{StaticResource CenterContentBorderBlurRadius}"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="Transparent"
                                    BorderBrush="{StaticResource CenterContentBorderColor}"
                                    BorderThickness="{StaticResource CenterContentBorderThickness}"
                                    CornerRadius="2" IsHitTestVisible="False"/>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextOptions.TextHintingMode="Animated">
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                           FontSize="11" FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                           Opacity="{StaticResource InformationHeaderShadowOpacity}">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontFamily="{StaticResource MGS4PrimaryFont}"
                                           FontSize="11" FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderTextColor}"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames
                                                Storyboard.TargetName="HoverHighlight"
                                                Storyboard.TargetProperty="Opacity"
                                                RepeatBehavior="Forever">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.306"/>
                                                <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0.34"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.17">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.306"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverHighlight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Transparent modal shield prevents interaction with the main UI. -->
        <Border x:Name="SettingsInputShield"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                Panel.ZIndex="99"
                Background="Transparent"
                Focusable="True"
                Visibility="{Binding Visibility, ElementName=SettingsOverlay}"
                PreviewMouseDown="SettingsInputShield_PreviewMouseDown"
                PreviewMouseWheel="SettingsInputShield_PreviewMouseWheel"/>

        <!-- Centered settings overlay: 30% of the 1280 x 720 primary design size. -->
        <Grid x:Name="SettingsOverlay"
              Grid.Column="0"
              Grid.ColumnSpan="5"
              Panel.ZIndex="100"
              Width="384"
              Height="216"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="Transparent"
              RenderTransformOrigin="0.5,0.5"
              UseLayoutRounding="False"
              SnapsToDevicePixels="False"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SettingsOverlayScale"
                                    ScaleX="1"
                                    ScaleY="1"/>
                    <TranslateTransform x:Name="SettingsOverlayTranslation"
                                        X="0"
                                        Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="1"/>
            </Grid.CacheMode>

            <!-- Exact background gradient and opacity used by the SETTINGS button. -->
            <Border CornerRadius="2"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="0,1">
                        <GradientStop Color="#E6142014" Offset="0"/>
                        <GradientStop Color="#BF4A5540" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border x:Name="SettingsOverlayOuterBorder"
                    Background="Transparent"
                    BorderThickness="2"
                    CornerRadius="2"
                    IsHitTestVisible="False">
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="SettingsOverlayBorderBrush"
                                     Color="#94A48A"/>
                </Border.BorderBrush>
            </Border>

            <Border x:Name="SettingsOverlayGlowBorder"
                    Background="Transparent"
                    BorderBrush="{StaticResource GlowColor}"
                    BorderThickness="2"
                    CornerRadius="2"
                    Margin="1"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="White"
                                      ShadowDepth="0"
                                      BlurRadius="5"
                                      Opacity="0.10"/>
                </Border.Effect>
            </Border>

            <!-- Settings title: duplicate of the main iPod label, reduced by 2pt. -->
            <Grid Margin="12,5,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False"
                  UseLayoutRounding="False"
                  SnapsToDevicePixels="False"
                  TextOptions.TextHintingMode="Animated">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{StaticResource SettingsHeaderLabel}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Opacity="0.35">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                    </ItemsControl.RenderTransform>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="{StaticResource MGS4PrimaryFont}"
                                       FontSize="19"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource CenterHeaderShadowColor}"
                                       Margin="{StaticResource CenterHeaderCharacterSpacing}"
                                       TextOptions.TextFormattingMode="Ideal"
                                       TextOptions.TextRenderingMode="Grayscale"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{StaticResource SettingsHeaderLabel}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="{StaticResource MGS4PrimaryFont}"
                                       FontSize="19"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource CenterHeaderTextColor}"
                                       Margin="{StaticResource CenterHeaderCharacterSpacing}"
                                       TextOptions.TextFormattingMode="Ideal"
                                       TextOptions.TextRenderingMode="Grayscale"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                    <TextBlock Text="v1.0"
                               FontFamily="{StaticResource MGS4TertiaryFont}"
                               FontSize="12"
                               Foreground="{StaticResource CenterHeaderShadowColor}"
                               Opacity="0.35"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Grayscale">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                Y="{StaticResource CenterHeaderShadowOffset}"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="v1.0"
                               FontFamily="{StaticResource MGS4TertiaryFont}"
                               FontSize="12"
                               Foreground="{StaticResource CenterHeaderTextColor}"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Grayscale"/>
                </Grid>
            </Grid>

            <StackPanel Margin="12,31,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        UseLayoutRounding="False"
                        SnapsToDevicePixels="False"
                        TextOptions.TextHintingMode="Animated">
                <Grid IsHitTestVisible="False">
                    <TextBlock Text="Developed by "
                               FontFamily="{StaticResource MGS4TertiaryFont}"
                               FontSize="12" FontWeight="Normal"
                               Foreground="{StaticResource CenterHeaderShadowColor}"
                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Grayscale">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="2" Y="2"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="Developed by "
                               FontFamily="{StaticResource MGS4TertiaryFont}"
                               FontSize="12" FontWeight="Normal"
                               Foreground="{StaticResource CenterHeaderTextColor}"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Grayscale"/>
                </Grid>

                <Button Padding="0" Margin="0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Focusable="False"
                        MouseEnter="MenuSelectSound_MouseEnter"
                        Click="NitroidLink_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid Background="Transparent">
                                <TextBlock Text="Nitroid"
                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                           FontSize="12" FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderShadowColor}"
                                           Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="2" Y="2"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="Nitroid"
                                           Style="{StaticResource WindowControlGlyphPulseStyle}"
                                           FontFamily="{StaticResource MGS4TertiaryFont}"
                                           FontSize="12" FontWeight="Normal"
                                           Foreground="{StaticResource CenterHeaderTextColor}"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="Grayscale"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Special-thanks copy of the Information annotation field. -->
            <StackPanel Margin="12,55,0,0"
                        Width="190"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False">
                <Grid UseLayoutRounding="False"
                      SnapsToDevicePixels="False"
                      TextOptions.TextHintingMode="Animated">
                    <TextBlock Text="SPECIAL THANKS"
                               FontFamily="{StaticResource MGS4PrimaryFont}"
                               FontSize="8"
                               FontWeight="Normal"
                               Foreground="{StaticResource CenterHeaderShadowColor}"
                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Grayscale">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                Y="{StaticResource CenterHeaderShadowOffset}"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="SPECIAL THANKS"
                               FontFamily="{StaticResource MGS4PrimaryFont}"
                               FontSize="8"
                               FontWeight="Normal"
                               Foreground="{StaticResource CenterHeaderTextColor}"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Grayscale"/>
                </Grid>

                <Canvas x:Name="SpecialThanksScrollViewport"
                        Margin="0,4,0,0"
                        Height="104"
                        ClipToBounds="True"
                        UseLayoutRounding="False"
                        SnapsToDevicePixels="False"
                        TextOptions.TextHintingMode="Animated">
                    <StackPanel x:Name="SpecialThanksScrollContent"
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Width="190">
                        <StackPanel.Resources>
                            <Style x:Key="SpecialThanksShadowText" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource MGS4TertiaryFont}"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="Foreground" Value="{StaticResource CenterHeaderShadowColor}"/>
                                <Setter Property="Opacity" Value="{StaticResource InformationHeaderShadowOpacity}"/>
                                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                                <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                            Y="{StaticResource CenterHeaderShadowOffset}"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="SpecialThanksText" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource MGS4TertiaryFont}"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="Foreground" Value="{StaticResource CenterHeaderTextColor}"/>
                                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                                <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
                            </Style>
                        </StackPanel.Resources>
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="SpecialThanksScrollTranslation"/>
                        </StackPanel.RenderTransform>
                        <Grid Height="13"><TextBlock Text="My wife and kids" Style="{StaticResource SpecialThanksShadowText}"/><TextBlock Text="My wife and kids" Style="{StaticResource SpecialThanksText}"/></Grid>
                        <Grid Height="13"><TextBlock Text="BarbarousDuke1" Style="{StaticResource SpecialThanksShadowText}"/><TextBlock Text="BarbarousDuke1" Style="{StaticResource SpecialThanksText}"/></Grid>
                        <Grid Height="13"><TextBlock Text="deltaplus" Style="{StaticResource SpecialThanksShadowText}"/><TextBlock Text="deltaplus" Style="{StaticResource SpecialThanksText}"/></Grid>
                        <Grid Height="13"><TextBlock Text="F1NG3RS" Style="{StaticResource SpecialThanksShadowText}"/><TextBlock Text="F1NG3RS" Style="{StaticResource SpecialThanksText}"/></Grid>
                        <Grid Height="13"><TextBlock Text="ghzgangster" Style="{StaticResource SpecialThanksShadowText}"/><TextBlock Text="ghzgangster" Style="{StaticResource SpecialThanksText}"/></Grid>
                        <Grid Height="13"><TextBlock Text="Hunari" Style="{StaticResource SpecialThanksShadowText}"/><TextBlock Text="Hunari" Style="{StaticResource SpecialThanksText}"/></Grid>
                        <Grid Height="13"><TextBlock Text="J.Ingram" Style="{StaticResource SpecialThanksShadowText}"/><TextBlock Text="J.Ingram" Style="{StaticResource SpecialThanksText}"/></Grid>
                        <Grid Height="13"><TextBlock Text="Kitsyfluff" Style="{StaticResource SpecialThanksShadowText}"/><TextBlock Text="Kitsyfluff" Style="{StaticResource SpecialThanksText}"/></Grid>
                        <Grid Height="13"><TextBlock Text="MekaMaxine" Style="{StaticResource SpecialThanksShadowText}"/><TextBlock Text="MekaMaxine" Style="{StaticResource SpecialThanksText}"/></Grid>
                        <Grid Height="13"><TextBlock Text="otac0n" Style="{StaticResource SpecialThanksShadowText}"/><TextBlock Text="otac0n" Style="{StaticResource SpecialThanksText}"/></Grid>
                        <Grid Height="13"><TextBlock Text="TriggerHappy" Style="{StaticResource SpecialThanksShadowText}"/><TextBlock Text="TriggerHappy" Style="{StaticResource SpecialThanksText}"/></Grid>
                    </StackPanel>
                </Canvas>
            </StackPanel>

            <!-- Global sound-effects toggle. -->
            <Grid Margin="12,0,0,14"
                  Height="21"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="21"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="DisableSoundEffectsToggle"
                              Grid.Column="0"
                              Width="21"
                              Height="21"
                              IsChecked="False"
                              Click="SoundEffectsToggle_Click"
                              Focusable="False">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Grid>
                                <Rectangle x:Name="CheckmarkIcon"
                                           Fill="#6B716B"
                                           Opacity="0.55"
                                           SnapsToDevicePixels="False"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="Assets/Images/icon_checkmark.png"
                                                    Stretch="Uniform"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>

                                <Border Background="Transparent"
                                        BorderBrush="{StaticResource CenterContentBorderColor}"
                                        BorderThickness="{StaticResource CenterContentBorderThickness}"
                                        CornerRadius="2"
                                        Opacity="{StaticResource CenterContentBorderSoftOpacity}"
                                        IsHitTestVisible="False">
                                    <Border.Effect>
                                        <BlurEffect Radius="{StaticResource CenterContentBorderBlurRadius}"/>
                                    </Border.Effect>
                                </Border>

                                <Border Background="Transparent"
                                        BorderBrush="{StaticResource CenterContentBorderColor}"
                                        BorderThickness="{StaticResource CenterContentBorderThickness}"
                                        CornerRadius="2"
                                        IsHitTestVisible="False"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckmarkIcon"
                                            Property="Fill"
                                            Value="#62CEE6"/>
                                    <Setter TargetName="CheckmarkIcon"
                                            Property="Opacity"
                                            Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Grid Grid.Column="2"
                      VerticalAlignment="Center"
                      UseLayoutRounding="False"
                      SnapsToDevicePixels="False"
                      TextOptions.TextHintingMode="Animated"
                      IsHitTestVisible="False">
                    <TextBlock Text="Disable Sound Effects"
                               FontFamily="{StaticResource MGS4TertiaryFont}"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{StaticResource CenterHeaderShadowColor}"
                               Opacity="{StaticResource InformationHeaderShadowOpacity}"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Grayscale">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="2" Y="2"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock Text="Disable Sound Effects"
                               FontFamily="{StaticResource MGS4TertiaryFont}"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{StaticResource CenterHeaderTextColor}"
                               TextOptions.TextFormattingMode="Ideal"
                               TextOptions.TextRenderingMode="Grayscale"/>
                </Grid>
            </Grid>

            <!-- Animated Otacon portrait, revealed after the window finishes opening. -->
            <Image x:Name="SettingsOtaconSprite"
                   Width="96"
                   Height="142"
                   Margin="0,0,-6,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   Visibility="Collapsed"
                   IsHitTestVisible="True"
                   Cursor="Hand"
                   MouseLeftButtonDown="SettingsOtaconSprite_MouseLeftButtonDown"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   SnapsToDevicePixels="True">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="SettingsOtaconSpriteTranslation"/>
                </Image.RenderTransform>
            </Image>

            <!-- Copy of the main window close control; this closes only the overlay. -->
            <Button Width="24"
                    Height="24"
                    Margin="0,2,2,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Focusable="False"
                    MouseEnter="MenuSelectSound_MouseEnter"
                    Click="CloseSettingsOverlay_Click">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent"
                              UseLayoutRounding="False"
                              SnapsToDevicePixels="False"
                              TextOptions.TextHintingMode="Animated">
                            <TextBlock Text="X"
                                       FontFamily="{StaticResource MGS4TertiaryFont}"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource CenterHeaderShadowColor}"
                                       Opacity="{StaticResource InformationHeaderShadowOpacity}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextOptions.TextFormattingMode="Ideal"
                                       TextOptions.TextRenderingMode="Grayscale">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="{StaticResource CenterHeaderShadowOffset}"
                                                        Y="{StaticResource CenterHeaderShadowOffset}"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="X"
                                       Style="{StaticResource WindowControlGlyphPulseStyle}"
                                       FontFamily="{StaticResource MGS4TertiaryFont}"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource CenterHeaderTextColor}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextOptions.TextFormattingMode="Ideal"
                                       TextOptions.TextRenderingMode="Grayscale"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

    </Grid>

</Window>
